// Esquema de Prisma.
//
// Fase 1: roles, usuarios y auditoría mínima.
// Fase 2: catálogo — categorías, unidades, productos, especificaciones e
// imágenes.
// Fase 3: movimientos de inventario (InventoryMovement), motor transaccional
// y endpoints de stock.
// Fase 4: clientes (Customer), tipos, etapas y estados, restricciones e
// índices, y el cliente genérico "Público general".
// Fase 5, Bloque A: secuencias de documentos (DocumentSequence) y modelo de
// cotizaciones (Quote, QuoteItem), snapshots de cliente/producto,
// restricciones e índices. Sin servicio, sin controller, sin endpoints
// todavía; eso llega en los Bloques B-D.
// Fase 6, Bloque A: modelo de ventas (Sale, SaleItem), snapshot de cliente
// (con customerType nullable por Público general), relación opcional y
// única con Quote, campos resumen de pago preparados para la Fase 7
// (paymentStatus/paidAmount/balanceDue, sin modelo Payment todavía),
// restricciones e índices. Sin servicio, sin controller, sin endpoints
// todavía; eso llega en los Bloques B-D.
// Fase 8, Bloque A: precontabilidad básica (Account/AccountingEntry/
// AccountingEntryLine — Documento Maestro §17: chart_of_accounts,
// accounting_entries, accounting_entry_lines). Seis cuentas de sistema
// fijas (Caja, Bancos, Cuentas por cobrar, IGV por pagar, Ventas,
// Descuentos), sin CRUD ni asientos manuales. Solo modelo + migración +
// constraints + seed de las seis cuentas; sin AccountingEngine, sin
// integración con PaymentEngine/SalesService, sin auditoría contable, sin
// HTTP todavía — eso llega en los Bloques B-D.
// Fase 10, Bloque A: configuración de la empresa (CompanySettings), fila
// singleton única. Modelo + migración + constraints + seed + SettingsReader
// + GET/PATCH /api/v1/configuration (solo campos de identidad/moneda en
// este bloque) + auditoría. quoteValidityDays/maxDiscountPercent se
// integran con Cotizaciones/Ventas en el Bloque B; taxEnabled/taxRate con
// el cálculo de IGV en el Bloque C. Sin cambios a document_sequences ni a
// DocumentSequenceService en este bloque: la administración de secuencias
// es el Bloque D.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  SELLER
  WAREHOUSE
  MANAGEMENT
  // Fase A4: lectura global del dominio contable (plan de cuentas,
  // periodos, asientos, reportes) + ciclo de vida completo de asientos
  // manuales (crear/editar borrador, contabilizar, revertir) — nunca
  // administración de ventas/inventario/usuarios/configuración, que
  // siguen exigiendo ADMIN explícitamente en cada guard propio.
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum UnitStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  PRODUCT
  SERVICE
}

// El tipo representa únicamente la naturaleza y dirección del cambio de
// stock. No se agregan SALE/PURCHASE/RETURN/REVERSAL como movementType:
// eso mezclaría el eje "qué le pasa al stock" con el eje "por qué"
// (InventoryMovementOrigin, abajo).
enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

// RETURN queda fuera: devoluciones a proveedor siguen fuera del MVP
// (CLAUDE.md §7). SALE/SALE_CANCELLATION se declararon para que la Fase de
// Ventas no requiriera migrar el enum; PURCHASE_RECEIPT/
// PURCHASE_RECEIPT_CANCELLATION (Fase A5.2b) siguen el mismo criterio para
// las recepciones físicas de compra — StockMovementEngine sigue siendo el
// único escritor de InventoryMovement/Product.stockCurrent para ambos.
enum InventoryMovementOrigin {
  MANUAL
  INITIAL_BALANCE
  SALE
  SALE_CANCELLATION
  PURCHASE_RECEIPT
  PURCHASE_RECEIPT_CANCELLATION
  OTHER
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        RoleName   @unique
  description String?    @db.VarChar(200)
  userRoles   UserRole[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("roles")
}

// KAN-18: un User puede tener uno o más roles asignados (autorización
// persistente); la sesión/JWT elige exactamente UNO como rol activo
// (activeRole, nunca persistido en User — ver TokenService/JwtAuthGuard).
// onDelete: Cascade del lado de User (quitar la membresía de un usuario
// eliminado es correcto); onDelete: Restrict del lado de Role (mismo
// criterio que el antiguo User.roleId: un Role en uso no puede eliminarse).
// @@unique([userId, roleId]) impide asignar el mismo rol dos veces al mismo
// usuario; sirve además como target de upsert idempotente en seed/fixtures.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String   @map("role_id") @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model User {
  id                         String               @id @default(uuid()) @db.Uuid
  firstName                  String               @map("first_name") @db.VarChar(80)
  lastName                   String               @map("last_name") @db.VarChar(80)
  username                   String               @unique @db.VarChar(50)
  email                      String               @unique @db.VarChar(150)
  passwordHash               String               @map("password_hash") @db.VarChar(255)
  // KAN-18: roleId/role (relación singular) se reemplazan por roles
  // (UserRole[]) — autorización persistente de uno o más roles. El rol
  // ACTIVO de una sesión nunca se persiste aquí (ver TokenService.sign()/
  // JwtAuthGuard): solo vive en el JWT firmado, validado en vivo contra
  // esta colección en cada petición.
  roles                      UserRole[]
  status                     UserStatus           @default(ACTIVE)
  mustChangePassword         Boolean              @default(true) @map("must_change_password")
  failedLoginAttempts        Int                  @default(0) @map("failed_login_attempts")
  blockedAt                  DateTime?            @map("blocked_at")
  lastLoginAt                DateTime?            @map("last_login_at")
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")
  auditLogs                  AuditLog[]
  inventoryMovements         InventoryMovement[]
  // Cotizaciones donde este usuario es el emisor comercial (sellerId =
  // actor autenticado que creó la cotización; ver D12, Fase 5). No implica
  // que el usuario tenga rol SELLER: un ADMIN también puede emitir.
  issuedQuotes               Quote[]
  // Ventas donde este usuario es el vendedor (D10, Fase 6): directa = actor
  // autenticado; desde cotización = Quote.sellerId (no necesariamente quien
  // ejecuta la conversión). Dos relaciones nombradas porque Sale referencia
  // User dos veces (vendedor y quien anula).
  soldSales                  Sale[]               @relation("SaleSeller")
  cancelledSales             Sale[]               @relation("SaleCancelledBy")
  // Pagos (Fase 7, Bloque A): dos relaciones nombradas porque Payment
  // referencia User dos veces (quien registra y quien anula), mismo
  // criterio que soldSales/cancelledSales arriba.
  createdPayments            Payment[]            @relation("PaymentCreatedBy")
  cancelledPayments          Payment[]            @relation("PaymentCancelledBy")
  // Arqueos de caja (Ticket B post-MVP, Bloque B1: solo persistencia, sin
  // reglas de negocio todavía). Dos relaciones nombradas por el mismo
  // motivo que Sale/Payment arriba: CashSession referencia User dos veces
  // (el cobrador dueño de la caja y, opcionalmente, quien aprueba un cierre
  // con descuadre).
  cashSessions               CashSession[]        @relation("CashSessionOwner")
  approvedCashSessions       CashSession[]        @relation("CashSessionApprovedBy")
  // Asientos contables (Fase 8, Bloque A): un único actor por asiento (quien
  // ejecutó la operación de negocio que lo generó); a diferencia de
  // Sale/Payment, un AccountingEntry nunca se "anula" con el mismo actor
  // relation — su reversión es una fila nueva con su propio createdBy.
  createdAccountingEntries   AccountingEntry[]    @relation("AccountingEntryCreatedBy")
  // Periodos contables (Fase A2.1): dos relaciones nombradas porque
  // AccountingPeriod referencia User dos veces (quien cierra y, si aplica,
  // quien reabre), mismo criterio que Sale/Payment arriba.
  closedAccountingPeriods    AccountingPeriod[]   @relation("AccountingPeriodClosedBy")
  reopenedAccountingPeriods  AccountingPeriod[]   @relation("AccountingPeriodReopenedBy")
  // Borradores de asiento manual creados por este usuario (Fase A4.2).
  createdManualJournalDrafts ManualJournalDraft[] @relation("ManualJournalDraftCreatedBy")
  // Facturas de compra (Fase A5.2a): dos relaciones nombradas porque
  // PurchaseInvoice referencia User dos veces (quien la crea y, si aplica,
  // quien la anula), mismo criterio que Sale/Payment/AccountingPeriod.
  createdPurchaseInvoices   PurchaseInvoice[]    @relation("PurchaseInvoiceCreatedBy")
  cancelledPurchaseInvoices PurchaseInvoice[]    @relation("PurchaseInvoiceCancelledBy")
  // Recepciones de mercadería (Fase A5.2b): mismo criterio exacto que
  // PurchaseInvoice arriba (quien la crea y, si aplica, quien la anula).
  createdPurchaseReceipts   PurchaseReceipt[]    @relation("PurchaseReceiptCreatedBy")
  cancelledPurchaseReceipts PurchaseReceipt[]    @relation("PurchaseReceiptCancelledBy")
  // Pagos a proveedor (Fase A5.3): mismo criterio exacto que
  // PurchaseInvoice/PurchaseReceipt arriba (quien lo crea y, si aplica,
  // quien lo anula).
  createdSupplierPayments   SupplierPayment[]    @relation("SupplierPaymentCreatedBy")
  cancelledSupplierPayments SupplierPayment[]    @relation("SupplierPaymentCancelledBy")
  // Valorización de inventario (Fase A6.1): quien registró cada evento
  // (ORIGINAL o REVERSAL) — nunca editable, mismo criterio que el resto
  // del dominio.
  createdInventoryValuations InventoryValuation[]

  @@index([status])
  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  module      String   @db.VarChar(50)
  action      String   @db.VarChar(60)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  description String   @db.VarChar(500)
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// --- Catálogo (Fase 2, Bloque A) -------------------------------------------

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique @db.VarChar(30)
  name        String         @db.VarChar(120)
  description String?        @db.VarChar(500)
  parentId    String?        @map("parent_id") @db.Uuid
  parent      Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]     @relation("CategoryHierarchy")
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0) @map("sort_order")
  products    Product[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // La unicidad de nombre por nivel (case-insensitive, raíz vs. con padre)
  // se agrega a mano en migration.sql mediante índices únicos parciales:
  // Prisma no expresa LOWER(name) ni WHERE parent_id IS NULL de forma
  // declarativa en el DSL.
  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model Unit {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @unique @db.VarChar(15)
  name         String     @db.VarChar(60)
  abbreviation String     @db.VarChar(10)
  allowDecimal Boolean    @default(false) @map("allow_decimal")
  status       UnitStatus @default(ACTIVE)
  products     Product[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("units")
}

model Product {
  id                    String                 @id @default(uuid()) @db.Uuid
  sku                   String                 @unique @db.VarChar(40)
  name                  String                 @db.VarChar(150)
  brand                 String?                @db.VarChar(80)
  productType           ProductType            @map("product_type")
  categoryId            String                 @map("category_id") @db.Uuid
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitId                String                 @map("unit_id") @db.Uuid
  unit                  Unit                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  salePrice             Decimal                @map("sale_price") @db.Decimal(14, 2)
  commercialDescription String?                @map("commercial_description") @db.VarChar(1000)
  internalNotes         String?                @map("internal_notes") @db.VarChar(1000)
  isInventoryTracked    Boolean                @default(true) @map("is_inventory_tracked")
  stockCurrent          Decimal                @default(0) @map("stock_current") @db.Decimal(14, 3)
  stockMinimum          Decimal                @default(0) @map("stock_minimum") @db.Decimal(14, 3)

  // Fase A6.1: NULL (default, en todo producto de toda fase anterior y en
  // todo producto nuevo) significa "sin valorización — comportamiento
  // actual sin cambios". Un valor NO NULL activa, para ESTE producto
  // únicamente, el cálculo de costo al recibir compras (A6.1 nunca lo
  // activa automáticamente ni lo siembra; se configura hoy solo vía
  // Prisma directo — ver CLAUDE.md §11 — hasta que exista un
  // procedimiento formal de activación/cambio retroactivo). Cambiar este
  // valor cuando el producto YA tiene InventoryValuation registrada es
  // responsabilidad de InventoryValuationEngine, nunca de un UPDATE
  // directo sobre esta columna.
  valuationMethod InventoryValuationMethod? @map("valuation_method")

  status                ProductStatus          @default(ACTIVE)
  specifications        ProductSpecification[]
  images                ProductImage[]
  movements             InventoryMovement[]
  // Fase A6.1: historial inmutable de eventos de valorización de este
  // producto (ORIGINAL por recepción, REVERSAL por cancelación). Nunca
  // una fuente de verdad alternativa a stockCurrent: el saldo FÍSICO
  // sigue siendo exclusivamente StockMovementEngine/Product.stockCurrent.
  inventoryValuations   InventoryValuation[]
  quoteItems            QuoteItem[]
  saleItems             SaleItem[]
  // Fase A5.2a: líneas de compra que referencian este producto (opcional —
  // a diferencia de SaleItem, una PurchaseInvoiceLine puede no tener
  // producto). Nunca escribe stockCurrent desde aquí: A5.2a no modifica
  // inventario (responsabilidad exclusiva de A5.2b, todavía no
  // implementada).
  purchaseInvoiceLines  PurchaseInvoiceLine[]
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  // CHECK de sale_price/stock_current/stock_minimum >= 0 agregados a mano
  // en migration.sql (Prisma DSL no soporta @@check en esta versión).
  @@index([categoryId])
  @@index([unitId])
  @@index([status])
  @@index([productType])
  @@index([isInventoryTracked])
  @@map("products")
}

model ProductSpecification {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(80)
  value     String   @db.VarChar(300)
  unit      String?  @db.VarChar(20)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Unicidad case-insensitive (product_id, LOWER(name)) agregada a mano en
  // migration.sql.
  @@index([productId])
  @@map("product_specifications")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName    String   @map("file_name") @db.VarChar(255)
  storagePath String   @map("storage_path") @db.VarChar(500)
  mimeType    String   @map("mime_type") @db.VarChar(100)
  fileSize    Int      @map("file_size")
  sortOrder   Int      @default(0) @map("sort_order")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")

  // Índice único parcial "una sola imagen principal por producto" agregado
  // a mano en migration.sql (product_id WHERE is_primary = true).
  @@index([productId])
  @@index([productId, isPrimary])
  @@map("product_images")
}

// --- Inventario (Fase 3, Bloque A) -----------------------------------------

model InventoryMovement {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  movementType InventoryMovementType   @map("movement_type")
  // Sin @default: cualquier inserción debe declarar explícitamente su
  // origen. Omitirlo no debe convertirse silenciosamente en MANUAL.
  origin       InventoryMovementOrigin

  quantity      Decimal @db.Decimal(14, 3)
  previousStock Decimal @map("previous_stock") @db.Decimal(14, 3)
  newStock      Decimal @map("new_stock") @db.Decimal(14, 3)

  reason String  @db.VarChar(200)
  notes  String? @db.VarChar(500)

  // Referencia polimórfica sin FK: aún no existen sales/purchases. Misma
  // técnica que AuditLog.entityType/entityId.
  referenceType String? @map("reference_type") @db.VarChar(50)
  referenceId   String? @map("reference_id") @db.VarChar(64)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  // Fase A6.1: a lo sumo UN evento de valorización por movimiento físico
  // (ORIGINAL si este ENTRY se valorizó al recibirse; REVERSAL si este
  // EXIT compensa el costo de una recepción cancelada) — la unicidad de
  // InventoryValuation.inventoryMovementId lo garantiza en base de datos.
  inventoryValuation InventoryValuation?

  // Sin updatedAt: un movimiento confirmado es inmutable (no hay
  // PATCH/DELETE). Sin deletedAt ni status: no hay borrado lógico de
  // movimientos, la corrección es un movimiento compensatorio (Bloque B).
  //
  // Los 6 CHECK y el índice único parcial de saldo inicial se agregan a
  // mano en migration.sql (el DSL de Prisma no los expresa), igual que en
  // la Fase 2.
  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([createdByUserId, createdAt])
  @@map("inventory_movements")
}

// --- Valorización de inventario (Fase A6.1) ---------------------------------
//
// Infraestructura de costeo, NUNCA activada por defecto: ningún producto de
// pos_db/pos_db_test nace con Product.valuationMethod distinto de NULL, y
// esta fase no siembra ni activa ninguno. StockMovementEngine sigue siendo
// el ÚNICO escritor del inventario FÍSICO (InventoryMovement/
// Product.stockCurrent) — InventoryValuationEngine nunca lo toca, nunca lo
// duplica como fuente de verdad: existencias valorizadas (cantidad
// valorizada, costo unitario promedio, valor total) se calculan SIEMPRE en
// tiempo de lectura replay-ando este historial inmutable, nunca desde una
// columna de saldo acumulado. Fuera de alcance de A6.1 (ver CLAUDE.md):
// consumo de valorización por venta (COGS, Fase A6.2) — esta fase NUNCA
// resta valorización al vender, así que `valuedQuantity` solo crece con
// recepciones mientras A6.2 no exista.

// MOVING_WEIGHTED_AVERAGE es la única implementada. FIFO se declara ahora
// (mismo criterio que AccountingSourceType.SALE en la Fase 5, Bloque A:
// declarar un valor futuro para no requerir migrar el enum más tarde) pero
// NINGÚN código de este repositorio lo interpreta todavía — asignarlo a un
// producto no tiene ningún efecto funcional en A6.1.
enum InventoryValuationMethod {
  MOVING_WEIGHTED_AVERAGE
  FIFO
}

// ORIGINAL: evento de valorización al recibir físicamente (A5.2b). REVERSAL:
// evento compensatorio al cancelar esa misma recepción — nunca edita ni
// elimina el ORIGINAL, mismo criterio exacto que AccountingEntry/
// AccountingEventType.
enum InventoryValuationEventType {
  ORIGINAL
  REVERSAL
}

// Fase A6.2: distingue el origen real del evento sin cambiar el eje
// ORIGINAL/REVERSAL ya existente. PURCHASE_RECEIPT: valorización por
// recepción física de compra (A5.2b, sin cambios). SALE: consumo de costo
// por la salida física de una venta confirmada (A6.2) o su reversión al
// anular. Mutuamente excluyente con purchaseReceiptLineId/saleItemId (CHECK
// en migration.sql): nunca ambos, nunca ninguno.
enum InventoryValuationSourceType {
  PURCHASE_RECEIPT
  SALE
}

/**
 * Evento inmutable de valorización de UN InventoryMovement físico (Fase
 * A6.1, extendido en A6.2) — nunca se edita ni se elimina; una corrección
 * es siempre un nuevo evento REVERSAL. Fuente del costo: la línea de
 * factura de compra (A5.2a) que originó la recepción (A5.2b) para
 * sourceType=PURCHASE_RECEIPT, o el SaleItem que originó el consumo para
 * sourceType=SALE (A6.2) — nunca inventada. Solo existe para un producto
 * con Product.valuationMethod configurado en el instante del movimiento —
 * un producto sin valorización habilitada nunca genera ninguna fila aquí,
 * y recibir/vender/cancelar se comporta exactamente igual que hoy (cero
 * cambio de comportamiento del inventario físico).
 */
model InventoryValuation {
  id String @id @default(uuid()) @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Único por movimiento físico: nunca dos eventos de valorización para
  // el mismo ENTRY/EXIT (reintentos HTTP nunca llegan aquí dos veces —
  // PurchaseReceiptsService/SalesService ya cortan el reintento antes de
  // generar un movimiento nuevo; esta unicidad es la segunda línea de
  // defensa en base de datos, mismo criterio que el resto del dominio).
  inventoryMovementId String            @unique @map("inventory_movement_id") @db.Uuid
  inventoryMovement   InventoryMovement @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict)

  sourceType InventoryValuationSourceType @map("source_type")

  // Origen real del costo cuando sourceType=PURCHASE_RECEIPT (A5.2b) —
  // NULL para sourceType=SALE (CHECK en migration.sql). Varias recepciones
  // PARCIALES de la misma PurchaseInvoiceLine producen varias filas
  // ORIGINAL distintas, una por cada PurchaseReceiptLine.
  purchaseReceiptLineId String?             @map("purchase_receipt_line_id") @db.Uuid
  purchaseReceiptLine   PurchaseReceiptLine? @relation(fields: [purchaseReceiptLineId], references: [id], onDelete: Restrict)

  // Origen real del consumo cuando sourceType=SALE (A6.2) — NULL para
  // sourceType=PURCHASE_RECEIPT (CHECK en migration.sql). Nunca exige una
  // PurchaseReceiptLine artificial para una salida por venta.
  saleItemId String?   @map("sale_item_id") @db.Uuid
  saleItem   SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  eventType InventoryValuationEventType @map("event_type")

  // Self-relation de reversión, mismo patrón exacto que
  // AccountingEntry.reversesEntryId: un ORIGINAL se revierte como máximo
  // una vez (unicidad implícita de esta columna).
  reversesValuationId String?             @unique @map("reverses_valuation_id") @db.Uuid
  reversesValuation    InventoryValuation? @relation("InventoryValuationReversal", fields: [reversesValuationId], references: [id], onDelete: Restrict)
  reversedByValuation  InventoryValuation? @relation("InventoryValuationReversal")

  // Método vigente para el producto EN EL INSTANTE de este evento —
  // snapshot inmutable, nunca releído de Product.valuationMethod después
  // (que podría cambiar vía un futuro procedimiento formal sin alterar
  // retroactivamente este historial).
  method InventoryValuationMethod

  quantity Decimal @db.Decimal(14, 3)

  // Desglose de qué se capitalizó, nunca el total bruto de la factura
  // (CLAUDE.md A6.1 §3): precio de compra neto de impuesto
  // (taxableBaseAmount de la línea) + impuesto NO acreditable (la porción
  // de taxAmount que no se recupera como crédito fiscal — exactamente la
  // misma fórmula ya usada por A5.2b para destinationAmount, nunca una
  // segunda regla). additionalCostsAmount queda en 0 en A6.1: flete/
  // seguros/aduanas son un punto de extensión explícito, nunca
  // implementado aquí (Importaciones sigue fuera de alcance). Para
  // sourceType=SALE (A6.2) este desglose no es aplicable (no hay un
  // "precio de compra" propio del consumo): purchasePriceAmount = totalCost
  // y los otros dos quedan en 0, reutilizando las mismas columnas en vez de
  // agregar otras nuevas (extensión mínima de esquema).
  purchasePriceAmount    Decimal @map("purchase_price_amount") @db.Decimal(14, 2)
  nonCreditableTaxAmount Decimal @map("non_creditable_tax_amount") @db.Decimal(14, 2)
  additionalCostsAmount  Decimal @default(0) @map("additional_costs_amount") @db.Decimal(14, 2)

  // SIEMPRE la suma exacta de los tres componentes de arriba — nunca
  // recalculado por separado (CHECK de consistencia en migration.sql).
  // Toda agregación de valorización (promedio ponderado, valor total)
  // suma SIEMPRE este campo, nunca quantity×unitCost: unitCost es
  // puramente informativo, derivado una sola vez aquí y nunca usado como
  // fuente de cálculo aguas abajo (evita pérdida/creación de valor por
  // redondeo acumulado).
  totalCost Decimal @map("total_cost") @db.Decimal(14, 2)
  unitCost  Decimal @map("unit_cost") @db.Decimal(18, 6)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  // Sin updatedAt: inmutable por diseño, igual que InventoryMovement.
  // Los CHECK (quantity > 0, montos >= 0, totalCost = suma de
  // componentes, unitCost >= 0, consistencia reversesValuationId según
  // eventType, y desde A6.2 la exclusividad mutua purchaseReceiptLineId/
  // saleItemId según sourceType) se agregan a mano en migration.sql.
  @@index([productId, createdAt])
  @@index([purchaseReceiptLineId])
  @@index([saleItemId])
  @@index([eventType, createdAt])
  @@index([sourceType, createdAt])
  @@map("inventory_valuations")
}

// --- Clientes (Fase 4, Bloque A) --------------------------------------------

enum CustomerType {
  PERSON
  COMPANY
}

enum CustomerStage {
  PROSPECT
  CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CustomerDocumentType {
  DNI
  RUC
  CE
  PASSPORT
  OTHER
}

model Customer {
  id String @id @default(uuid()) @db.Uuid

  // Gestionado por el sistema: nunca aceptado en un DTO de escritura. null
  // para todo cliente normal de esta fase (sin generador de correlativos
  // CUS-000001 todavía, eso es responsabilidad de la Fase 10); el único
  // valor no nulo en esta fase es 'PUBLIC_GENERAL', reservado para el
  // cliente genérico (ver CHECK customers_generic_code_consistency).
  code String? @unique @db.VarChar(30)

  // Nullable únicamente porque el cliente genérico "Público general" no
  // tiene tipo (ver CHECK customers_type_generic_consistency). Todo cliente
  // normal exige un valor explícito.
  customerType CustomerType? @map("customer_type")

  // Sin @default: un prospecto vs. un cliente es una decisión comercial que
  // el llamador siempre debe declarar explícitamente (mismo criterio que
  // InventoryMovement.origin en la Fase 3). PROSPECT -> CUSTOMER es la única
  // transición permitida; CUSTOMER -> PROSPECT no existe en ningún endpoint.
  customerStage CustomerStage @map("customer_stage")

  documentType   CustomerDocumentType? @map("document_type")
  documentNumber String?               @map("document_number") @db.VarChar(32)

  name          String  @db.VarChar(150)
  tradeName     String? @map("trade_name") @db.VarChar(150)
  contactName   String? @map("contact_name") @db.VarChar(120)
  phone         String? @db.VarChar(30)
  email         String? @db.VarChar(150)
  address       String? @db.VarChar(300)
  internalNotes String? @map("internal_notes") @db.VarChar(1000)

  // Identifica estructuralmente a "Público general": la aplicación nunca
  // debe resolverlo comparando name o code.
  isGeneric Boolean @default(false) @map("is_generic")

  status CustomerStatus @default(ACTIVE)

  // NR-02A: crédito configurable por cliente, exclusivo de ADMIN (ver
  // SalesService.assertCustomerDebtRules() y PATCH /customers/:id/credit).
  // @default(false) aquí es el valor para INSERT futuros (clientes nuevos);
  // los clientes ya existentes al migrar quedan en true por backfill
  // explícito en la migración (preservan el crédito ya vigente, nunca
  // dueDate ni límite monetario — fuera de alcance). El cliente genérico
  // "Público general" siempre queda en false (irrelevante en la práctica:
  // assertCustomerDebtRules lo bloquea de forma incondicional por
  // `isGeneric`, nunca por este campo).
  creditEnabled Boolean @default(false) @map("credit_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Cotizaciones emitidas a este cliente. La identidad del cliente queda
  // además snapshotada en cada Quote (customerType/customerName/...), así
  // que editar este registro nunca altera cotizaciones ya emitidas.
  quotes Quote[]
  // Ventas de este cliente. Igual que Quote, la identidad queda snapshotada
  // en cada Sale (Fase 6).
  sales  Sale[]

  // Sin deletedAt: no hay borrado físico de clientes con historial (igual
  // que el resto del dominio).
  //
  // Las 6 CHECK y el índice único parcial funcional de documento se añaden a
  // mano en migration.sql (el DSL de Prisma no expresa CHECK, WHERE parcial,
  // UPPER() ni BTRIM()), igual que en las Fases 2 y 3. No se crea un índice
  // único parcial adicional para el genérico: code @unique +
  // customers_generic_code_consistency ya garantizan como máximo una fila.
  @@index([createdAt, id])
  @@map("customers")
}

// --- Proveedores (Fase A5.1) ------------------------------------------------
// Maestro de datos puro: sin ningún vínculo a Compras/Cuentas por Pagar
// (todavía no existen) ni a AccountingEngine/AccountingSourceType (sin
// cambios en esta fase). Modelo deliberadamente SEPARADO de Customer —
// mismo criterio superficial (documento + datos de contacto) pero dominios
// y ciclos de vida distintos; nunca se comparte la tabla ni se crea un
// Customer artificial para representar un proveedor.

enum SupplierDocumentType {
  RUC
  DNI
  // Identificación tributaria extranjera genérica: evita inventar un enum
  // por país. Las compras/proveedores internacionales reales (formato,
  // validación) son responsabilidad de una fase de Importaciones futura.
  FOREIGN_TAX_ID
  OTHER
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

/**
 * A diferencia de Customer, aquí no existe un proveedor "genérico": todo
 * proveedor exige documento (documentType/documentNumber NUNCA nulos) — no
 * hay un caso análogo a "Público general" que lo justifique. Sin
 * createdByUserId/updatedByUserId: igual que Customer/Product/Category/Unit,
 * la autoría vive exclusivamente en AuditLog (ver SuppliersService) — esos
 * campos denormalizados en la propia fila son exclusivos de registros
 * TRANSACCIONALES (InventoryMovement/Payment/AccountingEntry/
 * ManualJournalDraft), nunca de maestros de datos.
 */
model Supplier {
  id String @id @default(uuid()) @db.Uuid

  documentType   SupplierDocumentType @map("document_type")
  documentNumber String               @db.VarChar(32) @map("document_number")

  // ISO 3166-1 alpha-2. 'PE' es el default aplicado por SuppliersService
  // cuando el llamador lo omite (igual criterio que
  // ProductsService/stockMinimum, NR-04) — nunca un @default de columna,
  // para que la normalización (incluida la validación de formato) pase
  // siempre por el servicio.
  countryCode String @map("country_code") @db.VarChar(2)

  legalName     String  @map("legal_name") @db.VarChar(150)
  tradeName     String? @map("trade_name") @db.VarChar(150)
  contactName   String? @map("contact_name") @db.VarChar(120)
  phone         String? @db.VarChar(30)
  email         String? @db.VarChar(150)
  address       String? @db.VarChar(300)
  internalNotes String? @map("internal_notes") @db.VarChar(1000)

  // Puramente informativo (ver Fase A5, blueprint §3/§11): ningún cálculo
  // ni posteo contable lo usa todavía. ISO 4217, ej. 'PEN'/'USD'.
  defaultCurrencyCode String? @map("default_currency_code") @db.VarChar(3)

  status SupplierStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Fase A5.2a: facturas de compra de este proveedor. La identidad del
  // proveedor queda además snapshotada indirectamente en cada
  // PurchaseInvoice vía supplierId (sin snapshot de nombre/documento en la
  // factura misma — a diferencia de Sale/Quote con Customer, A5.2a no lo
  // requirió; puede reconsiderarse en una fase posterior si se necesita).
  purchaseInvoices PurchaseInvoice[]

  // Fase A5.3: pagos registrados a este proveedor.
  supplierPayments SupplierPayment[]

  // Las 3 CHECK y el índice único funcional (documentType+countryCode+
  // UPPER(BTRIM(documentNumber))) se añaden a mano en migration.sql (mismo
  // motivo que Customer: el DSL de Prisma no expresa CHECK, UPPER() ni
  // BTRIM()). Sin WHERE parcial: a diferencia de Customer, el documento
  // nunca es nulo aquí.
  @@index([createdAt, id])
  @@map("suppliers")
}

// --- Compras universales (Fase A5.2a) ---------------------------------------
// PurchaseInvoice/PurchaseInvoiceLine son el modelo ÚNICO y universal: una
// misma factura mezcla libremente bienes catalogados, bienes sin catálogo
// y servicios (ver PurchaseAcquisitionKind/PurchasePurpose abajo). Nunca
// modifica stock (StockMovementEngine/InventoryMovement no se tocan en
// esta fase — eso es A5.2b, todavía no implementada). El reconocimiento
// contable usa EXCLUSIVAMENTE AccountingEngine (postPurchaseRecognition(),
// nuevo), nunca un motor paralelo.

enum PurchaseInvoiceDocumentType {
  FACTURA
  BOLETA
  RECIBO
  OTHER
}

enum PurchaseInvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// Dimensión A del blueprint de A5.2 (qué se adquiere). Determina si la
// línea puede ser elegible para recepción física (solo GOOD) — nunca por
// sí sola: también exige productId + Product.isInventoryTracked=true,
// evaluado y CONGELADO en PurchaseInvoiceLine.isReceiptEligible al
// confirmar (ver ese campo).
enum PurchaseAcquisitionKind {
  GOOD
  SERVICE
  OTHER
}

// Dimensión B (destino contable/de negocio de la línea) — NUNCA inferida
// del nombre del producto ni de su categoría de venta, siempre un valor
// explícito. Determina qué AccountingSystemKey (PURCHASE_*) resuelve la
// cuenta destino al confirmar; cuál sea esa cuenta REAL (de tránsito o
// final) es una decisión de mapeo del contador, no una regla codificada.
enum PurchasePurpose {
  RESALE_INVENTORY
  INTERNAL_CONSUMPTION
  FIXED_ASSET
  OPERATING_EXPENSE
  OTHER
}

// Clasificación tributaria ESTRUCTURAL de la línea (qué dice el documento
// del proveedor) — nunca una regla de deducibilidad inventada aquí. TAXED
// exige taxBasis+taxRateSnapshot; los demás los exigen NULL y
// taxAmount=creditableTaxAmount=0 (CHECK en migration.sql).
enum PurchaseLineTaxCategory {
  TAXED
  EXEMPT
  UNAFFECTED
  OTHER
}

// Si el importe de la línea YA incluye el impuesto o lo excluye — por
// LÍNEA, nunca por factura completa (dos proveedores distintos en la
// misma factura pueden facturar de forma distinta).
enum PurchaseLineTaxBasis {
  TAX_INCLUDED
  TAX_EXCLUDED
}

/**
 * documentSeries es NULLABLE (muchos documentos extranjeros no tienen
 * serie separada) — la unicidad real se mantiene con COALESCE en el índice
 * funcional de migration.sql (ver ese archivo), nunca con el comportamiento
 * nativo de NULL de PostgreSQL. documentNumber nunca se genera con
 * DocumentSequenceService: es el número que el PROVEEDOR le puso a su
 * propio documento.
 *
 * accountingDate es SIEMPRE explícita (nunca derivada de un instante,
 * mismo criterio que ManualJournalDraft, Fase A4) — distinta de issueDate
 * (fecha del proveedor) y registrationDate (cuándo DemoSystem la registra,
 * puramente informativa, sin ninguna validación de periodo atada).
 */
model PurchaseInvoice {
  id String @id @default(uuid()) @db.Uuid

  supplierId String   @map("supplier_id") @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  documentType   PurchaseInvoiceDocumentType @map("document_type")
  documentSeries String?                     @map("document_series") @db.VarChar(20)
  documentNumber String                      @map("document_number") @db.VarChar(32)

  issueDate        DateTime  @map("issue_date") @db.Date
  registrationDate DateTime  @map("registration_date") @db.Date
  accountingDate   DateTime  @map("accounting_date") @db.Date
  dueDate          DateTime? @map("due_date") @db.Date
  paymentTermsDays Int?      @map("payment_terms_days")

  // Snapshot inmutable desde la creación (nunca aceptado del cliente):
  // siempre CompanySettings.currencyCode vigente en ese instante, mismo
  // criterio que Sale.currencyCode. Restringe el alcance operativo a la
  // moneda única de la empresa (PEN) sin impedir una futura Fase de
  // Importaciones que sí acepte otra.
  currencyCode String @map("currency_code") @db.VarChar(3)

  // Siempre una SUMA de las líneas (nunca un valor independiente ni
  // recalculado por una tasa única de documento): subtotal=ΣtaxableBase,
  // taxAmount=Σtax, totalAmount=Σtotal de línea.
  subtotal    Decimal @db.Decimal(14, 2)
  taxAmount   Decimal @map("tax_amount") @db.Decimal(14, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(14, 2)

  status PurchaseInvoiceStatus @default(DRAFT)

  // AccountingEntry definitivo (sourceType=PURCHASE), null mientras
  // DRAFT/CANCELLED sin contabilizar. Mismo patrón que
  // ManualJournalDraft.postedEntryId (A4): único, RESTRICT.
  postedEntryId String?          @unique @map("posted_entry_id") @db.Uuid
  postedEntry   AccountingEntry? @relation(fields: [postedEntryId], references: [id], onDelete: Restrict)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("PurchaseInvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  confirmedAt DateTime? @map("confirmed_at")

  cancelledAt        DateTime? @map("cancelled_at")
  cancelledByUserId   String?   @map("cancelled_by_user_id") @db.Uuid
  cancelledBy         User?     @relation("PurchaseInvoiceCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines PurchaseInvoiceLine[]

  // Recepciones físicas (Fase A5.2b): una factura CONFIRMED puede tener
  // varias, cada una referenciando líneas isReceiptEligible=true de ESTA
  // factura. Nunca presente mientras DRAFT (no se puede recibir contra un
  // borrador).
  receipts PurchaseReceipt[]

  // Pagos a proveedor (Fase A5.3): asignaciones de SupplierPayment contra
  // ESTA factura. El saldo pendiente NUNCA se persiste en esta tabla —
  // siempre se calcula en tiempo de lectura a partir de totalAmount menos
  // la suma de asignaciones de pagos ACTIVE (mismo criterio que
  // isReceiptEligible/receiptLines arriba: nunca una fuente de verdad
  // duplicada).
  paymentAllocations SupplierPaymentAllocation[]

  // El índice único funcional (supplier_id, document_type,
  // UPPER(BTRIM(COALESCE(document_series,''))), UPPER(BTRIM(document_number)))
  // y los CHECK de cabecera se agregan a mano en migration.sql (mismo
  // motivo que Supplier/Customer: el DSL de Prisma no expresa CHECK,
  // UPPER(), BTRIM() ni COALESCE()).
  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt, id])
  @@map("purchase_invoices")
}

/**
 * productId NULLABLE (a diferencia de SaleItem.productId, siempre
 * obligatorio): una compra admite conceptos sin catálogo. descriptionSnapshot
 * es SIEMPRE obligatoria — si hay producto, el servicio la copia de
 * Product.name por defecto; si no, el llamador debe proveerla. Sin
 * @@unique([purchaseInvoiceId, productId]) (a diferencia de SaleItem): una
 * compra puede tener dos líneas del mismo producto (lotes/costos
 * distintos).
 *
 * isReceiptEligible es NULL mientras la factura es DRAFT (todavía no se
 * congela nada) y se calcula EXACTAMENTE UNA VEZ al confirmar, a partir de
 * Product.isInventoryTracked vigente en ese instante — nunca se vuelve a
 * leer después, para que un cambio posterior de esa configuración no
 * altere retroactivamente la política de una línea ya confirmada (riesgo
 * identificado en la revisión de A5.2). A5.2a nunca crea una recepción;
 * este campo solo queda listo para que A5.2b lo consuma sin releer
 * Product.
 */
model PurchaseInvoiceLine {
  id                String          @id @default(uuid()) @db.Uuid
  purchaseInvoiceId String          @map("purchase_invoice_id") @db.Uuid
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  descriptionSnapshot String  @map("description_snapshot") @db.VarChar(300)
  unitCodeSnapshot    String? @map("unit_code_snapshot") @db.VarChar(15)
  unitNameSnapshot    String? @map("unit_name_snapshot") @db.VarChar(60)

  acquisitionKind PurchaseAcquisitionKind @map("acquisition_kind")
  purchasePurpose PurchasePurpose         @map("purchase_purpose")

  quantity  Decimal @db.Decimal(14, 3)
  unitCost  Decimal @map("unit_cost") @db.Decimal(14, 2)

  taxCategory       PurchaseLineTaxCategory @map("tax_category")
  taxBasis          PurchaseLineTaxBasis?   @map("tax_basis")
  taxRateSnapshot   Decimal?                @map("tax_rate_snapshot") @db.Decimal(5, 2)
  taxableBaseAmount Decimal                 @map("taxable_base_amount") @db.Decimal(14, 2)
  taxAmount         Decimal                 @map("tax_amount") @db.Decimal(14, 2)
  // Nunca inferido de taxCategory (A5.2 corrección explícita): cuánto de
  // taxAmount se reconoce como crédito fiscal es un valor propio, decidido
  // por quien registra la línea — default 0 (nunca asumir deducibilidad).
  creditableTaxAmount Decimal @default(0) @map("creditable_tax_amount") @db.Decimal(14, 2)

  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)

  isReceiptEligible Boolean? @map("is_receipt_eligible")

  // Fase A5.2b: recepciones físicas registradas contra esta línea. La
  // cantidad pendiente/parcial/completa se calcula SIEMPRE en tiempo de
  // lectura a partir de la suma de PurchaseReceiptLine de recepciones
  // ACTIVE — nunca una columna duplicada en esta tabla (riesgo de drift).
  receiptLines PurchaseReceiptLine[]

  createdAt DateTime @default(now()) @map("created_at")

  // Sin updatedAt: igual que SaleItem, una factura CONFIRMED no edita sus
  // líneas (se anula, no se corrige) — mientras DRAFT, PurchaseInvoicesService
  // reemplaza el arreglo completo (deleteMany+createMany), mismo patrón que
  // ManualJournalDraftLine (A4). Los CHECK de línea (cantidad/montos >= 0,
  // creditableTaxAmount <= taxAmount, consistencia taxCategory/taxBasis,
  // lineTotal = taxableBaseAmount + taxAmount, isReceiptEligible solo
  // posible con GOOD+productId) se agregan a mano en migration.sql.
  @@index([purchaseInvoiceId])
  @@index([productId])
  @@map("purchase_invoice_lines")
}

// Fase A5.2b: igual criterio de dos estados que ManualJournalDraftStatus/
// CashSessionStatus anteriores — sin PENDING/DRAFT: una recepción nace
// efectiva (mueve stock de inmediato, dentro de la misma transacción que
// la crea) y solo puede pasar a CANCELLED después.
enum PurchaseReceiptStatus {
  ACTIVE
  CANCELLED
}

/**
 * Recepción física de mercadería (Fase A5.2b), independiente en el tiempo
 * de la confirmación de la PurchaseInvoice (R2.2a ya reconoce contablemente
 * la factura completa al confirmarse — ver §11, CLAUDE.md). Una factura
 * puede tener múltiples recepciones (entregas parciales); cada una referencia
 * líneas de UNA sola factura, nunca mezcla líneas de facturas distintas
 * (PurchaseReceiptLine.purchaseInvoiceLineId siempre pertenece a
 * purchaseInvoiceId de este mismo registro, validado por el servicio).
 * Nunca se elimina físicamente: ACTIVE -> CANCELLED únicamente.
 */
model PurchaseReceipt {
  id String @id @default(uuid()) @db.Uuid

  purchaseInvoiceId String          @map("purchase_invoice_id") @db.Uuid
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)

  receivedDate DateTime @map("received_date") @db.Date

  status PurchaseReceiptStatus @default(ACTIVE)

  // Idempotencia (A5.2b §3): opcional, provisto por el cliente HTTP (p. ej.
  // un UUID generado una vez por intento lógico de creación, reenviado tal
  // cual en un reintento). NULL es el caso normal (sin protección de
  // idempotencia solicitada) — Postgres permite múltiples NULL en un índice
  // único multi-columna, así que esto nunca friega la unicidad entre
  // recepciones sin clave. Único por factura (nunca global): dos facturas
  // distintas pueden reusar la misma clave sin colisión real.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(100)

  notes String? @db.VarChar(500)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("PurchaseReceiptCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  cancelledAt        DateTime? @map("cancelled_at")
  cancelledByUserId  String?   @map("cancelled_by_user_id") @db.Uuid
  cancelledBy        User?     @relation("PurchaseReceiptCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(300)

  // AccountingEntry de RECLASIFICACIÓN (sourceType=PURCHASE_RECEIPT), NULL
  // cuando ninguna cuenta destino involucrada tiene tránsito configurado
  // (el caso predeterminado y seguro — ver Account.
  // receiptReclassificationTargetAccountId). Nunca presente para una línea
  // de servicio/no elegible: esas nunca generan ningún asiento.
  reclassificationEntryId String?          @unique @map("reclassification_entry_id") @db.Uuid
  reclassificationEntry   AccountingEntry? @relation(fields: [reclassificationEntryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines PurchaseReceiptLine[]

  // El CHECK de consistencia de cancelación (status/cancelledAt/
  // cancelledByUserId/cancellationReason, mismo criterio exacto que
  // purchase_invoices_cancellation_consistency) se agrega a mano en
  // migration.sql.
  @@unique([purchaseInvoiceId, idempotencyKey])
  @@index([purchaseInvoiceId, createdAt])
  @@index([status, createdAt])
  @@map("purchase_receipts")
}

/**
 * Línea de recepción: cuánto se recibió de UNA PurchaseInvoiceLine en ESTA
 * PurchaseReceipt. Nunca expone costo/monto (CLAUDE.md A5.2b §6: "no
 * exponer costos a roles sin autorización") — exclusivamente cantidad
 * física. El monto de reclasificación contable (si aplica) se persiste
 * aparte, en reclassifiedAmount, para que anular la recepción revierta
 * EXACTAMENTE lo posteado, nunca un recálculo que pueda derivar por
 * redondeo.
 */
model PurchaseReceiptLine {
  id                String          @id @default(uuid()) @db.Uuid
  purchaseReceiptId String          @map("purchase_receipt_id") @db.Uuid
  purchaseReceipt   PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)

  purchaseInvoiceLineId String              @map("purchase_invoice_line_id") @db.Uuid
  purchaseInvoiceLine   PurchaseInvoiceLine @relation(fields: [purchaseInvoiceLineId], references: [id], onDelete: Restrict)

  quantity Decimal @db.Decimal(14, 3)

  // NULL cuando esta línea no disparó reclasificación contable (caso
  // predeterminado); monto exacto debitado/acreditado cuando sí la disparó
  // — ver PurchaseReceipt.reclassificationEntryId. Nunca recalculado al
  // anular: la reversión usa este valor tal cual.
  reclassifiedAmount Decimal? @map("reclassified_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  // Fase A6.1: hasta dos filas (ORIGINAL al recibir + REVERSAL si la
  // recepción se cancela) — nunca más, nunca menos de las que de verdad
  // ocurrieron.
  inventoryValuations InventoryValuation[]

  // CHECK de cantidad positiva se agrega a mano en migration.sql.
  @@unique([purchaseReceiptId, purchaseInvoiceLineId])
  @@index([purchaseReceiptId])
  @@index([purchaseInvoiceLineId])
  @@map("purchase_receipt_lines")
}

// Fase A5.3: igual criterio de dos estados que PurchaseReceiptStatus — un
// pago nace efectivo (postea de inmediato, dentro de la misma transacción
// que lo crea) y solo puede pasar a CANCELLED después.
enum SupplierPaymentStatus {
  ACTIVE
  CANCELLED
}

/**
 * Pago a proveedor (Fase A5.3), distribuible entre una o varias
 * PurchaseInvoice CONFIRMED del MISMO proveedor (ver SupplierPaymentAllocation).
 * Las obligaciones nacen de facturas CONFIRMED, nunca de recepciones
 * físicas (A5.2b es independiente). Nunca se elimina físicamente: ACTIVE ->
 * CANCELLED únicamente.
 */
model SupplierPayment {
  id String @id @default(uuid()) @db.Uuid

  supplierId String   @map("supplier_id") @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  paymentDate DateTime @map("payment_date") @db.Date

  // Siempre la SUMA de sus asignaciones (SupplierPaymentAllocation.amount) —
  // validado por el servicio al crear, nunca un valor independiente.
  amount Decimal @db.Decimal(14, 2)

  // Snapshot inmutable desde la creación: siempre
  // CompanySettings.currencyCode vigente en ese instante (mismo criterio
  // que PurchaseInvoice.currencyCode, A5.2a) — nunca aceptado del cliente.
  // Debe coincidir con la moneda de CADA factura pagada (validado por el
  // servicio): A0.2 ya impide que currencyCode diverja mientras existe
  // historia financiera, así que este chequeo es defensa en profundidad,
  // nunca una vía real de multimoneda.
  currencyCode String @map("currency_code") @db.VarChar(3)

  // FK viva + snapshot histórico hacia el método de pago dinámico (mismo
  // criterio exacto que Payment, Ticket C, Bloque C3): un pago ya
  // registrado nunca cambia de significado porque un ADMIN edite el
  // método después. accountingDestination nunca se snapshotea aquí (igual
  // que Payment): ese hecho contable ya queda inmutable, por separado, en
  // AccountingEntryLine.
  paymentMethodId   String        @map("payment_method_id") @db.Uuid
  paymentMethod     PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentMethodCode String        @map("payment_method_code") @db.VarChar(30)
  paymentMethodName String        @map("payment_method_name") @db.VarChar(60)

  reference String? @db.VarChar(100)

  // Idempotencia (mismo criterio exacto que PurchaseReceipt.idempotencyKey,
  // A5.2b): opcional, único por proveedor, nunca global.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(100)

  status SupplierPaymentStatus @default(ACTIVE)

  // AccountingEntry definitivo (sourceType=SUPPLIER_PAYMENT). Nunca NULL
  // mientras ACTIVE: a diferencia de PurchaseReceipt.reclassificationEntryId
  // (opcional), un SupplierPayment SIEMPRE contabiliza — nunca existe sin
  // su asiento.
  postedEntryId String          @unique @map("posted_entry_id") @db.Uuid
  postedEntry   AccountingEntry @relation(fields: [postedEntryId], references: [id], onDelete: Restrict)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("SupplierPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  cancelledAt        DateTime? @map("cancelled_at")
  cancelledByUserId  String?   @map("cancelled_by_user_id") @db.Uuid
  cancelledBy        User?     @relation("SupplierPaymentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  allocations SupplierPaymentAllocation[]

  // El CHECK de consistencia de cancelación (mismo criterio exacto que
  // purchase_receipts_cancellation_consistency) se agrega a mano en
  // migration.sql.
  @@unique([supplierId, idempotencyKey])
  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@map("supplier_payments")
}

/**
 * Cuánto de UN SupplierPayment se aplicó a UNA PurchaseInvoice. Varias
 * asignaciones del MISMO pago pueden repartirse entre varias facturas del
 * MISMO proveedor (validado por el servicio); nunca dos asignaciones del
 * mismo pago contra la misma factura (una sola fila por par, @@unique).
 */
model SupplierPaymentAllocation {
  id String @id @default(uuid()) @db.Uuid

  supplierPaymentId String          @map("supplier_payment_id") @db.Uuid
  supplierPayment    SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)

  purchaseInvoiceId String          @map("purchase_invoice_id") @db.Uuid
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  // CHECK de monto positivo se agrega a mano en migration.sql.
  @@unique([supplierPaymentId, purchaseInvoiceId])
  @@index([supplierPaymentId])
  @@index([purchaseInvoiceId])
  @@map("supplier_payment_allocations")
}

// --- Secuencias de documentos y cotizaciones (Fase 5, Bloque A) ------------

// SALE se declara ahora (sin sembrarse) para que la futura Fase de Ventas no
// requiera migrar el enum, mismo precedente que InventoryMovementOrigin en
// la Fase 3.
enum DocumentType {
  QUOTE
  SALE
}

// EXPIRED es principalmente un estado EFECTIVO derivado de fecha (ver
// Bloque B: effectiveStatus()); la columna status puede persistirlo si en
// el futuro existiera un proceso que lo consolide, pero la Fase 5 no lo
// escribe nunca. CONVERTED existe por compatibilidad de esquema con la
// Fase 6; la Fase 5 no implementa la conversión.
enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

// Secuencia transaccional mínima para correlativos generados en backend
// (COT ahora, NV en la Fase 6). Sin CRUD de administración: eso es Fase 10.
// current_number es el ÚLTIMO número emitido (no el próximo): el Bloque B
// incrementa primero y luego formatea con el valor resultante.
model DocumentSequence {
  id            String       @id @default(uuid()) @db.Uuid
  documentType  DocumentType @unique @map("document_type")
  prefix        String       @db.VarChar(10)
  currentNumber Int          @default(0) @map("current_number")
  padding       Int          @default(6)
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Los 3 CHECK (current_number >= 0, padding entre 1 y 12, prefix no en
  // blanco) se agregan a mano en migration.sql.
  @@map("document_sequences")
}

model Quote {
  id     String      @id @default(uuid()) @db.Uuid
  // Generado exclusivamente en backend (DocumentSequenceService, Bloque B);
  // sin generador/default en la base de datos.
  number String      @unique @db.VarChar(30)
  status QuoteStatus @default(PENDING)

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Snapshot de identidad del cliente (D4): un cliente válido para cotizar
  // nunca es el genérico, así que customerType nunca es null aquí (a
  // diferencia de Customer.customerType, que sí lo permite para "Público
  // general"). documentType/documentNumber siguen siendo nullable porque un
  // cliente normal puede legítimamente no tener documento registrado.
  customerType           CustomerType          @map("customer_type")
  customerDocumentType   CustomerDocumentType? @map("customer_document_type")
  customerDocumentNumber String?               @map("customer_document_number") @db.VarChar(32)
  customerName           String                @map("customer_name") @db.VarChar(150)
  customerAddress        String?               @map("customer_address") @db.VarChar(300)

  // Emisor comercial: el usuario autenticado que creó la cotización (D12).
  // No se valida que tenga rol SELLER (un ADMIN también puede emitir); sin
  // funcionalidad de reasignación en esta fase.
  sellerId String @map("seller_id") @db.Uuid
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  // @db.Date: la vigencia es un concepto de día calendario, sin semántica de
  // hora ni huso (ver utilidad de fecha de negocio America/Lima, Bloque B).
  // Sin @default: el Bloque B siempre fija issueDate explícitamente a la
  // fecha de negocio del momento de creación.
  issueDate      DateTime @map("issue_date") @db.Date
  expirationDate DateTime @map("expiration_date") @db.Date

  subtotal       Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  // Siempre 0.00 en la Fase 5 (D5): IGV configurable llega en la Fase 10.
  // Presente desde ahora para que activar el impuesto sea aditivo.
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)

  // Fase 11, Bloque B: contexto de moneda/impuesto vigente en el momento
  // EXACTO en que se calculó el snapshot comercial de arriba (mismo
  // instante que taxAmount) — mismos tipos/CHECK que CompanySettings.
  // Nunca se releen para exponer una respuesta ni se recalculan por
  // separado: se escriben juntos con subtotal/discountAmount/taxAmount/
  // total en create()/update() (solo cuando ese update afecta realmente
  // los montos comerciales) y se copian VERBATIM en la conversión a Sale.
  // Sin esto, facturación electrónica no tendría forma segura de saber con
  // qué moneda/tasa de IGV se emitió históricamente un documento si
  // CompanySettings cambia después.
  currencyCode String  @map("currency_code") @db.VarChar(3)
  taxEnabled   Boolean @map("tax_enabled")
  taxRate      Decimal @map("tax_rate") @db.Decimal(5, 2)

  // R2-B1: semántica de precios con la que se calcularon los montos de
  // ESTE documento. false = semántica histórica (unitPrice/lineTotal antes
  // de IGV, IGV sumado a nivel de documento); true = precios finales con
  // IGV incluido cuando aplica. Toda fila previa a R2 quedó en false
  // (relleno de la migración). Sin @default a propósito: cada escritor
  // debe fijarla explícitamente; se copia VERBATIM a Sale en la conversión.
  pricesIncludeTax Boolean @map("prices_include_tax")

  notes String?     @db.VarChar(1000)
  items QuoteItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Venta generada a partir de esta cotización (Fase 6): a lo sumo una,
  // impuesta por Sale.quoteId @unique. null mientras no se haya convertido.
  // Tras una conversión exitosa, Quote.status pasa a CONVERTED en la misma
  // transacción (Bloque B de la Fase 6); esta relación nunca se usa para
  // reabrir ni reutilizar la cotización.
  sale Sale?

  // Sin deletedAt: una cotización se rechaza, no se borra.
  //
  // Los 9 CHECK de cabecera se agregan a mano en migration.sql (aritmética
  // exacta, par de documento del snapshot, etc.).
  @@index([customerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt, id])
  @@index([expirationDate])
  @@index([issueDate])
  @@map("quotes")
}

// NR-03: descuento individual de línea. FIXED = discountValue es un importe
// en soles (nunca mayor que el bruto de la línea); PERCENT = discountValue
// es un porcentaje 0-100. Compartido por QuoteItem/SaleItem/
// ElectronicDocumentItem (mismo criterio que PaymentMethodAccountingDestination:
// un solo tipo reutilizado por varias tablas).
enum LineDiscountType {
  FIXED
  PERCENT
}

model QuoteItem {
  id      String @id @default(uuid()) @db.Uuid
  quoteId String @map("quote_id") @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Snapshot exigido por el documento maestro: nombre, SKU, unidad y precio.
  // Un QuoteItem histórico conserva estos valores aunque el producto cambie
  // de nombre, precio o se desactive después.
  productSku       String @map("product_sku") @db.VarChar(40)
  productName      String @map("product_name") @db.VarChar(150)
  unitCode         String @map("unit_code") @db.VarChar(15)
  unitName         String @map("unit_name") @db.VarChar(60)
  unitAbbreviation String @map("unit_abbreviation") @db.VarChar(10)

  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)

  // NR-03: descuento individual de línea, independiente del descuento de
  // documento (Quote.discountAmount), que sigue aplicándose ADICIONALMENTE
  // sobre Σ lineTotal. null/null/0 (nunca escrito explícitamente por
  // CustomersService.create()-style default, sino por ausencia de los
  // campos en el INSERT) es la semántica histórica: ausencia total de
  // descuento, idéntica línea a línea al cálculo de siempre
  // (lineTotal = ROUND(quantity*unitPrice,2)). discountValue es el valor
  // tal cual lo ingresó el usuario (soles si FIXED, 0-100 si PERCENT);
  // discountAmount es siempre el equivalente ya calculado en soles, única
  // fuente de verdad para lineTotal. Ver quote-calculator.ts
  // calculateLineDiscount() y los CHECK de consistencia en migration.sql.
  discountType   LineDiscountType? @map("discount_type")
  discountValue  Decimal?          @map("discount_value") @db.Decimal(14, 2)
  discountAmount Decimal           @default(0) @map("discount_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  // Sin updatedAt: un QuoteItem inmutable individualmente — la edición de
  // Fase 5 reemplaza el conjunto completo de ítems (Bloque B), nunca un
  // ítem suelto.
  //
  // D13: como máximo un ítem por producto por cotización. quoteId como
  // prefijo izquierdo de este único compuesto ya cubre "cargar ítems de una
  // cotización"; no se agrega un @@index([quoteId]) adicional (redundante).
  // Los 3 CHECK (quantity > 0, unit_price >= 0, line_total >= 0), el CHECK
  // de aritmética (ahora con discount_amount) y los CHECK de consistencia
  // de descuento se agregan a mano en migration.sql.
  @@unique([quoteId, productId])
  @@index([productId])
  @@map("quote_items")
}

// --- Ventas / POS (Fase 6, Bloque A) ----------------------------------------

enum SaleStatus {
  ACTIVE
  CANCELLED
}

// Resumen de pago de la venta. UNPAID/PAID son los únicos valores que el
// servicio de la Fase 6 produce (D1, D18): sin modelo Payment todavía,
// ninguna venta puede terminar en PARTIALLY_PAID de forma operativa.
// PARTIALLY_PAID existe para que la Fase 7 no requiera migrar el enum: una
// vez exista Payment, este campo se recalculará transaccionalmente desde los
// pagos ACTIVE.
enum SalePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// NOT_APPLICABLE: ningún ítem de la venta es inventariable actualmente al
// confirmar (D12). Estado de entrega separado del estado de la venta: la
// anulación no lo modifica (D13/§34 del plan aprobado).
enum SaleDeliveryStatus {
  NOT_APPLICABLE
  PENDING
  DELIVERED
  OBSERVED
}

model Sale {
  id     String     @id @default(uuid()) @db.Uuid
  // Generado exclusivamente en backend (DocumentSequenceService, Bloque B);
  // sin generador/default en la base de datos. Formato NV-000001 (D3).
  number String     @unique @db.VarChar(30)
  status SaleStatus @default(ACTIVE)

  // Resumen de pago (D1/D18, preparación para la Fase 7): en la Fase 6,
  // total > 0 => UNPAID (paidAmount=0, balanceDue=total); total = 0 => PAID
  // (paidAmount=0, balanceDue=0). Sin fila Payment: nunca se reclama dinero
  // recibido sin trazabilidad.
  paymentStatus  SalePaymentStatus  @map("payment_status")
  deliveryStatus SaleDeliveryStatus @map("delivery_status")

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Snapshot de identidad del cliente (D7). A diferencia de Quote,
  // customerType es NULLABLE aquí: Público general (isGeneric=true) tiene
  // customerType=null y SÍ puede vender (a diferencia de Quote, que lo
  // prohíbe por completo). Ver CHECK sales_customer_type_generic_consistency.
  customerIsGeneric      Boolean               @map("customer_is_generic")
  customerType           CustomerType?         @map("customer_type")
  customerDocumentType   CustomerDocumentType? @map("customer_document_type")
  customerDocumentNumber String?               @map("customer_document_number") @db.VarChar(32)
  customerName           String                @map("customer_name") @db.VarChar(150)
  customerAddress        String?               @map("customer_address") @db.VarChar(300)

  // Vendedor comercial (D10): venta directa = actor autenticado; venta desde
  // cotización = Quote.sellerId (no necesariamente quien ejecuta la
  // conversión, que queda trazado en AuditLog.userId).
  sellerId String @map("seller_id") @db.Uuid
  seller   User   @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  // Cotización de origen (D11): nullable + UNIQUE implementa "una cotización
  // -> a lo sumo una venta". null en toda venta directa. onDelete Restrict:
  // una cotización convertida nunca puede eliminarse físicamente.
  quoteId String? @unique @map("quote_id") @db.Uuid
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  subtotal       Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  // Siempre 0.00 en la Fase 6, igual que Quote.taxAmount (D5 heredado de la
  // Fase 5): IGV configurable llega en la Fase 10.
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)

  // Fase 11, Bloque B: mismo criterio que Quote (arriba). En una venta
  // directa se copian del ÚNICO snapshot de SettingsReader ya leído para
  // taxAmount (nunca una segunda lectura); en una venta desde cotización se
  // copian VERBATIM de Quote, igual que subtotal/discountAmount/taxAmount/
  // total — nunca de CompanySettings vigente al convertir.
  currencyCode String  @map("currency_code") @db.VarChar(3)
  taxEnabled   Boolean @map("tax_enabled")
  taxRate      Decimal @map("tax_rate") @db.Decimal(5, 2)

  // R2-B1: mismo significado que Quote.pricesIncludeTax. Venta directa: lo
  // fija SalesService; venta desde cotización: copia VERBATIM de Quote.
  // Sin @default a propósito (ver Quote).
  pricesIncludeTax Boolean @map("prices_include_tax")

  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(14, 2)
  balanceDue Decimal @map("balance_due") @db.Decimal(14, 2)

  // Instante real de confirmación (no @db.Date: a diferencia de la vigencia
  // de Quote, este es un momento exacto, no un día calendario). Sin
  // @default: el Bloque B lo fija explícitamente al confirmar.
  confirmedAt DateTime @map("confirmed_at")

  // Anulación (D-cancelación): los tres campos son NULL mientras
  // status=ACTIVE y los tres están poblados cuando status=CANCELLED (ver
  // CHECK sales_cancellation_consistency). Motivo obligatorio, sin duplicar
  // su texto libre en AuditLog.
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(200)
  cancelledByUserId  String?   @map("cancelled_by_user_id") @db.Uuid
  cancelledBy        User?     @relation("SaleCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  items SaleItem[]

  // Pagos asociados (Fase 7, Bloque A: solo el modelo/relación; sin lógica
  // de negocio todavía). paidAmount/balanceDue/paymentStatus arriba siguen
  // siendo los campos de resumen escritos por la aplicación (Bloque B en
  // adelante reconciliará su valor contra SUM(payments ACTIVE) para ventas
  // ACTIVE); esta relación no introduce columnas de resumen duplicadas.
  payments Payment[]

  // Documentos fiscales electrónicos (Fase 11, Bloque B: solo el modelo/
  // relación; sin emisión todavía). Sale sigue siendo la única fuente de
  // verdad comercial — ElectronicDocument es un agregado fiscal aparte,
  // nunca al revés.
  electronicDocuments ElectronicDocument[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Sin deletedAt: una venta se anula, no se borra. Sin notes: "nota de
  // venta interna" es el documento HTML imprimible (Bloque C), no una
  // columna de texto libre.
  //
  // Las 18 CHECK de cabecera se agregan a mano en migration.sql (aritmética
  // exacta, snapshot de cliente, consistencia de pago/anulación, etc.).
  @@index([customerId, confirmedAt])
  @@index([sellerId, confirmedAt])
  @@index([status, confirmedAt])
  @@index([paymentStatus, confirmedAt])
  @@index([deliveryStatus, confirmedAt])
  @@index([confirmedAt, id])
  @@map("sales")
}

model SaleItem {
  id     String @id @default(uuid()) @db.Uuid
  saleId String @map("sale_id") @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Snapshot idéntico en forma a QuoteItem. En una venta desde cotización se
  // copia EXACTAMENTE del QuoteItem de origen (D9): nunca se repricea desde
  // Product.salePrice vigente.
  productSku       String @map("product_sku") @db.VarChar(40)
  productName      String @map("product_name") @db.VarChar(150)
  unitCode         String @map("unit_code") @db.VarChar(15)
  unitName         String @map("unit_name") @db.VarChar(60)
  unitAbbreviation String @map("unit_abbreviation") @db.VarChar(10)

  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)

  // NR-03: copiado EXACTAMENTE del QuoteItem de origen al convertir (D9,
  // mismo criterio que el resto del snapshot) — nunca recalculado. En una
  // venta DIRECTA (sin cotización) siempre queda null/null/0, igual que
  // antes de NR-03: CreateSaleItemDto no acepta descuento de línea.
  discountType   LineDiscountType? @map("discount_type")
  discountValue  Decimal?          @map("discount_value") @db.Decimal(14, 2)
  discountAmount Decimal           @default(0) @map("discount_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  // Fase A6.2: hasta dos filas (ORIGINAL al confirmar la venta + REVERSAL
  // si la venta se anula) cuando Product.valuationMethod está configurado
  // — vacío para un ítem de producto sin valorización habilitada (cero
  // cambio de comportamiento).
  inventoryValuations InventoryValuation[]

  // Sin updatedAt: una venta confirmada no se edita (se anula y se crea
  // otra), así que un SaleItem es inmutable desde su creación.
  //
  // Como máximo un ítem por producto por venta (D21). saleId como prefijo
  // izquierdo de este único compuesto ya cubre "cargar ítems de una venta";
  // no se agrega un @@index([saleId]) adicional (redundante). Los 3 CHECK
  // (quantity > 0, unit_price >= 0, line_total >= 0), el CHECK de
  // aritmética (ahora con discount_amount) y los CHECK de consistencia de
  // descuento se agregan a mano en migration.sql.
  @@unique([saleId, productId])
  @@index([productId])
  @@map("sale_items")
}

// Ciclo de vida de un pago individual. Concepto deliberadamente distinto de
// SalePaymentStatus (resumen agregado de la venta): un Payment ACTIVE/
// CANCELLED es un hecho financiero atómico; SalePaymentStatus es un
// UNPAID/PARTIALLY_PAID/PAID derivado de la suma de pagos ACTIVE.
enum PaymentStatus {
  ACTIVE
  CANCELLED
}

// Distingue una anulación manual (administrador, con motivo obligatorio) de
// la anulación automática en cascada al anular la venta que lo contiene
// (Bloque B: SalesService.cancel -> PaymentEngine.cancelAllActiveForSale).
enum PaymentCancellationSource {
  MANUAL
  SALE_CANCELLATION
}

/**
 * Pago asociado a una venta (Fase 7, Bloque A: solo modelo + migración +
 * constraints; sin PaymentEngine/PaymentsService/lógica de negocio todavía,
 * ver Bloque B). Todo pago pertenece a una venta: no hay pagos sueltos.
 * Nunca se edita ni se elimina físicamente: se anula (ACTIVE -> CANCELLED)
 * y se registra uno nuevo si corresponde.
 */
model Payment {
  id String @id @default(uuid()) @db.Uuid

  saleId String @map("sale_id") @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(14, 2)

  // Referencia operativa genérica (número de operación/depósito/voucher).
  // Obligatoria a nivel de base de datos SOLO hasta la Fase 7 clásica (CHECK
  // payments_reference_required_by_method, eliminado en la migración de
  // CONTRACT del Ticket C, Bloque C3): la regla es ahora dinámica
  // (PaymentMethod.requiresReference, resuelto en PaymentEngine dentro de
  // la misma transacción que crea este Payment) y no puede expresarse
  // verazmente como CHECK de una sola tabla. Nunca PAN/CVV/credenciales
  // bancarias.
  reference String? @db.VarChar(100)

  status PaymentStatus @default(ACTIVE)

  // Instante real de cobro. Sin @default: el Bloque B lo fija explícitamente
  // al registrar (mismo criterio que Sale.confirmedAt); el cliente nunca lo
  // controla ni puede retrofechar.
  paidAt DateTime @map("paid_at")

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // Anulación (ver CHECK payments_cancellation_consistency, migration.sql):
  // los cuatro campos son NULL mientras status=ACTIVE y los cuatro están
  // poblados cuando status=CANCELLED, con cancellationReason obligatorio y
  // no vacío únicamente cuando cancellationSource=MANUAL (NULL cuando es
  // SALE_CANCELLATION, para no duplicar el motivo de anulación de la venta).
  cancelledAt        DateTime?                  @map("cancelled_at")
  cancellationReason String?                    @map("cancellation_reason") @db.VarChar(200)
  cancelledByUserId  String?                    @map("cancelled_by_user_id") @db.Uuid
  cancelledBy        User?                      @relation("PaymentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  cancellationSource PaymentCancellationSource? @map("cancellation_source")

  createdAt DateTime @default(now()) @map("created_at")
  // A diferencia de SaleItem/QuoteItem (inmutables desde su creación), un
  // Payment sí muta legítimamente una vez: ACTIVE -> CANCELLED.
  updatedAt DateTime @updatedAt @map("updated_at")

  // --- Ticket C, Bloque C3 (CONTRACT) ------------------------------------
  // FK viva + snapshot histórico hacia el método de pago dinámico
  // (PaymentMethod, más abajo). Obligatorios desde la migración de CONTRACT
  // (`..._contract_dynamic_payment_methods`): todo Payment, sin excepción,
  // tiene un método dinámico resuelto — el antiguo enum `method` y su
  // columna ya no existen. PaymentEngine resuelve y persiste estos cuatro
  // campos dentro de la MISMA transacción que crea el Payment (nunca en un
  // paso separado).
  //
  // paymentMethodCode/paymentMethodName/paymentMethodAffectsCashDrawer son
  // el snapshot histórico (mismo criterio que QuoteItem/SaleItem frente a
  // Product): un pago ya registrado nunca cambia de significado porque
  // ADMIN edite después el método dinámico (nombre, affectsCashDrawer, o lo
  // que sea) — ver Ticket C, Bloque C3, prueba de snapshot. paymentMethodId
  // es la FK viva hacia PaymentMethod, útil para reportes/administración
  // (join opcional); NUNCA la fuente de verdad histórica por sí sola — esa
  // es siempre el snapshot. accountingDestination deliberadamente NO se
  // snapshotea aquí: ese hecho contable ya queda congelado, por separado,
  // en AccountingEntry/AccountingEntryLine (Fase 8) en el mismo instante.
  paymentMethodId                String        @map("payment_method_id") @db.Uuid
  paymentMethod                  PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentMethodCode              String        @map("payment_method_code") @db.VarChar(30)
  paymentMethodName              String        @map("payment_method_name") @db.VarChar(60)
  paymentMethodAffectsCashDrawer Boolean       @map("payment_method_affects_cash_drawer")

  // --- Ticket B post-MVP, Bloque B1 (persistencia únicamente) ------------
  // FK NULLABLE PARA SIEMPRE, a propósito: todo Payment anterior a este
  // bloque es histórico legítimo y jamás recibe una CashSession fabricada
  // (sin backfill, ver migration.sql). Un Payment nuevo, a partir de un
  // bloque de negocio posterior de Ticket B, exigirá una CashSession
  // abierta por regla de APLICACIÓN — nunca por NOT NULL de columna, porque
  // eso rompería retroactivamente todo el histórico pre-B1. onDelete:
  // Restrict, mismo criterio que el resto de las FK de Payment: una
  // CashSession nunca se borra físicamente mientras tenga Payments.
  cashSessionId String?      @map("cash_session_id") @db.Uuid
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)

  // Las 3 CHECK vigentes (monto positivo, referencia no vacía, consistencia
  // de anulación) se agregan a mano en migration.sql, mismo criterio que
  // Sale/Quote/InventoryMovement. El cuarto CHECK histórico
  // (payments_reference_required_by_method, basado en el enum) se eliminó
  // en la migración de CONTRACT del Bloque C3: la regla ya es dinámica y
  // cross-table, y no puede expresarse de forma veraz como CHECK de una
  // sola tabla — se valida en PaymentEngine, dentro de la misma transacción
  // de creación.
  //
  // (paymentMethodCode, paidAt, id): mismo criterio que (status, paidAt) y
  // (createdByUserId, paidAt) — dos sitios de consulta reales y ya
  // existentes filtran por este campo combinado con orden por paidAt
  // (PaymentsService.list, ReportsService.paymentsByMethod/R9), y a
  // diferencia del antiguo enum de 6 valores, el código dinámico tiene
  // cardinalidad suficiente (9 baseline + los que ADMIN cree) para que el
  // índice aporte selectividad real. Sin índice adicional sobre
  // paymentMethodId: ningún código de negocio filtra por esa FK viva
  // directamente (el filtrado histórico siempre usa el snapshot
  // paymentMethodCode, nunca un join en vivo — ver Ticket C, Bloque C3
  // §22/§24 del plan aprobado).
  //
  // (cashSessionId, status): Ticket B, Bloque B1 — patrón de consulta ya
  // aprobado para el futuro cálculo de cierre/actual de caja ("Payments
  // ACTIVE de esta CashSession"), mismo criterio evidenciado que los demás
  // índices compuestos de esta tabla. Ningún código de negocio lo consume
  // todavía en B1 (persistencia únicamente); se agrega ahora porque el
  // patrón de consulta ya está aprobado, no por especulación.
  @@index([saleId, paidAt])
  @@index([paidAt, id])
  @@index([status, paidAt])
  @@index([createdByUserId, paidAt])
  @@index([paymentMethodCode, paidAt, id])
  @@index([cashSessionId, status])
  @@map("payments")
}

// --- Métodos de pago dinámicos (Ticket C post-MVP) --------------------------
//
// Nombre final desde el Bloque C3 (CONTRACT): el antiguo `enum PaymentMethod`
// que colisionaba con este nombre ya no existe (eliminado en la migración de
// CONTRACT), así que el modelo dinámico — temporalmente `
// PaymentMethodDefinition` durante los Bloques C1/C2 (EXPAND) — recupera el
// nombre de dominio definitivo `PaymentMethod`. Rename puramente de la capa
// Prisma: la tabla física siempre fue, y sigue siendo, `payment_methods`
// (@@map sin cambios); ningún dato se movió ni se recreó por este rename.
enum PaymentMethodAccountingDestination {
  CASH
  BANK
}

/**
 * Configuración administrable de métodos de pago (Ticket C). Fuente de
 * verdad VIVA/administrable — nunca la fuente de verdad histórica de un
 * Payment ya registrado, que siempre es su propio snapshot
 * (Payment.paymentMethodCode/Name/AffectsCashDrawer). `code` es la
 * identidad estable e inmutable (nunca se deriva de `name`, que sí es
 * editable vía PaymentMethodsService); `active` nunca implica borrado
 * físico (histórico siempre visible vía el snapshot en Payment, incluso si
 * el método se desactiva o — en el caso legacy — nunca se reactiva).
 * `accountingDestination` es un concepto deliberadamente distinto de
 * `affectsCashDrawer`: el primero decide la cuenta contable de cobro
 * (Caja/Bancos, Fase 8 sin cambios, resuelto por PaymentEngine y pasado a
 * AccountingEngine.postPaymentCollection() ya resuelto — nunca snapshoteado
 * en Payment, esa historia ya queda inmutable en AccountingEntryLine); el
 * segundo decide si el monto cuenta como efectivo físico para el futuro
 * arqueo de caja (Ticket B) — nunca se solapan ni se infiere uno del otro.
 */
model PaymentMethod {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(30)
  name String @db.VarChar(60)

  active                Boolean                            @default(true)
  requiresReference     Boolean                            @map("requires_reference")
  affectsCashDrawer     Boolean                            @map("affects_cash_drawer")
  accountingDestination PaymentMethodAccountingDestination @map("accounting_destination")
  sortOrder             Int                                @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments             Payment[]
  // Desglose de cierres de caja por método (Ticket B post-MVP, Bloque B1:
  // tabla vacía hasta un bloque de negocio posterior).
  cashSessionSummaries CashSessionPaymentMethodSummary[]
  // Fase A5.3: pagos a proveedor registrados con este método.
  supplierPayments     SupplierPayment[]

  // Los 3 CHECK (code con formato ^[A-Z][A-Z0-9_]{1,29}$, name no en blanco,
  // sort_order >= 0) se agregan a mano en migration.sql, mismo criterio que
  // el resto del dominio. Sin índices adicionales sobre active/sortOrder:
  // PaymentMethodsService lista como máximo un puñado de filas (sin
  // paginación, ver su propio módulo) — un índice ahí no tiene ningún
  // beneficio evidenciado. @@unique(code) ya cubre la única búsqueda por
  // igualdad real (resolución de método en PaymentEngine, backfill de
  // migration.sql).
  @@map("payment_methods")
}

// Naturaleza contable de una cuenta (Fase 8, plan final aprobado, §7;
// ampliado en la Fase A1 — PCGE §4: "Evaluate whether the existing account
// type enum needs extensions for assets, liabilities, equity, revenue,
// expenses and costs"). Los cuatro valores originales (ASSET/LIABILITY/
// REVENUE/CONTRA_REVENUE) son los únicos usados por las seis cuentas de
// sistema y NUNCA cambian de significado. EQUITY/EXPENSE/COST se agregan
// de forma puramente aditiva (ningún valor existente se modifica ni se
// elimina) para que el plan de cuentas PCGE jerárquico (A1.1) pueda
// clasificar cuentas de patrimonio, gasto y costo — sin que A1 cree ni
// active ninguna cuenta real de esos tres tipos todavía (eso requiere el
// PCGE aprobado del contador, fuera de alcance de A1 según el kickoff).
// La naturaleza débito/crédito NORMAL de cada valor es un dato DERIVADO,
// nunca una columna nueva (ver accountNormalBalance() en
// account-hierarchy.utils.ts, mismo criterio que stockStatus en NR-04):
// ASSET/EXPENSE/COST/CONTRA_REVENUE -> débito; LIABILITY/EQUITY/REVENUE ->
// crédito.
enum AccountType {
  ASSET
  LIABILITY
  REVENUE
  CONTRA_REVENUE
  EQUITY
  EXPENSE
  COST
}

// Estado administrable de una cuenta del plan de cuentas (Fase A1 —
// PCGE §4/§5): mismo criterio exacto que CategoryStatus/UnitStatus (dos
// valores, sin un tercer estado "bloqueado" — eso no tiene caso de uso
// real para una cuenta contable). Las seis cuentas de sistema nacen y
// permanecen ACTIVE; desactivarlas está bloqueado a nivel de servicio
// (protección de cuentas de sistema, A1.2), nunca a nivel de schema.
enum AccountStatus {
  ACTIVE
  INACTIVE
}

// Clave estable de las seis cuentas de sistema fijas (plan final, §6/§8):
// única forma en que el dominio (futuro AccountingEngine, Bloque B) ubica
// una cuenta, nunca por code/name en texto libre. Cerrado en Fase 8: no hay
// cuentas personalizadas ni mapeo configurable.
enum AccountingSystemKey {
  CASH
  BANK
  ACCOUNTS_RECEIVABLE
  VAT_PAYABLE
  SALES_REVENUE
  DISCOUNTS
  // Fase A5.2a (compras universales). Ninguno de los 7 tiene un mapeo real
  // activado por esta fase (ver CLAUDE.md §11): existen como valores de
  // enum resolvibles por AccountingEngine.postPurchaseRecognition(), pero
  // activarlos exige que ADMIN asigne una cuenta PCGE real vía
  // PATCH /chart-of-accounts/system-keys/:systemKey (A1, sin cambios) —
  // una decisión del contador, nunca automática ni sembrada por seed.
  // ACCOUNTS_PAYABLE/VAT_RECEIVABLE son el espejo exacto de
  // ACCOUNTS_RECEIVABLE/VAT_PAYABLE. Los 5 PURCHASE_* son la cuenta
  // DESTINO configurable por cada PurchasePurpose de línea — su nombre
  // identifica el propósito de compra, nunca impone un tratamiento
  // contable (tránsito vs. cuenta final es una decisión de mapeo del
  // contador, no una regla codificada aquí; revisión A5.2 corrigió
  // explícitamente la asunción anterior de una cuenta puente obligatoria).
  ACCOUNTS_PAYABLE
  VAT_RECEIVABLE
  PURCHASE_RESALE_INVENTORY
  PURCHASE_INTERNAL_CONSUMPTION
  PURCHASE_FIXED_ASSET
  PURCHASE_OPERATING_EXPENSE
  PURCHASE_OTHER
  // Fase A6.2 (costo de ventas). Débito del costo reconocido al confirmar
  // una venta con líneas valorizadas (A6.1) — sin mapeo real activado por
  // esta fase (mismo criterio que los 7 anteriores): ADMIN debe asignarlo
  // vía PATCH /chart-of-accounts/system-keys/:systemKey antes de que
  // cualquier venta real con costeo pueda contabilizarse. El lado crédito
  // (inventario) nunca usa este ni ningún otro systemKey nuevo: se resuelve
  // por accountId REAL, igual que PostSupplierPaymentCollectionCommand —
  // la cuenta histórica que la compra original de ese producto realmente
  // usó (ver AccountingEngine.postCogsRecognition()).
  COST_OF_GOODS_SOLD
}

// Qué evento de negocio origina un AccountingEntry. Sin FK real hacia
// Sale/Payment (ver comentario en AccountingEntry.sourceId): es un
// polimorfismo deliberado, mismo criterio que AuditLog.entityType/entityId
// e InventoryMovement.referenceType/referenceId. MANUAL (Fase A4): el
// asiento DEFINITIVO de un borrador contabilizado — sourceId es el id del
// propio ManualJournalDraft, nunca un valor inventado; el índice único
// parcial accounting_entries_one_original_per_source (migration.sql) ya
// garantiza, sin código nuevo, que un mismo borrador nunca se contabilice
// dos veces.
// Fase A5.2a: PURCHASE — el asiento ORIGINAL de reconocimiento de una
// PurchaseInvoice confirmada (sourceId = PurchaseInvoice.id). Mismo
// polimorfismo sin FK, mismo índice único parcial
// accounting_entries_one_original_per_source ya existente (sin cambios),
// que impide por sí solo una doble contabilización.
enum AccountingSourceType {
  SALE
  PAYMENT
  MANUAL
  PURCHASE
  // Fase A5.2b: asiento de RECLASIFICACIÓN opcional posteado al recibir
  // físicamente una PurchaseInvoiceLine cuya cuenta destino (resuelta en
  // PURCHASE) está configurada como cuenta de tránsito
  // (Account.receiptReclassificationTargetAccountId). sourceId =
  // PurchaseReceipt.id — nunca el de la PurchaseInvoice: cancelar una
  // recepción revierte EXCLUSIVAMENTE este asiento, jamás el PURCHASE
  // original de la factura. Ausente (sin ningún AccountingEntry) cuando
  // ninguna cuenta involucrada tiene tránsito configurado — el caso
  // predeterminado y seguro mientras no exista una decisión del contador.
  PURCHASE_RECEIPT
  // Fase A5.3: cobro de un pago a proveedor (SupplierPayment.id). Debita
  // la(s) cuenta(s) de pasivo REALMENTE acreditadas en el/los asiento(s)
  // PURCHASE originales de cada factura pagada (nunca el mapeo VIGENTE de
  // ACCOUNTS_PAYABLE, que puede haberse reasignado desde entonces) y
  // acredita CASH/BANK según el método de pago — nunca vuelve a reconocer
  // la compra ni el IGV, nunca toca inventario.
  SUPPLIER_PAYMENT
  // Fase A6.2: costo de ventas (COGS) de una venta confirmada con al menos
  // una línea valorizada (A6.1). sourceId = Sale.id — DISTINTO de
  // (SALE, Sale.id), así que coexiste sin conflicto con el asiento de
  // reconocimiento de ingresos de la misma venta bajo el mismo índice único
  // parcial accounting_entries_one_original_per_source (sin cambios: la
  // tupla (sourceType, sourceId) es distinta). Ausente (sin ningún
  // AccountingEntry) cuando la venta no tiene ninguna línea con
  // Product.valuationMethod configurado — el caso normal mientras la
  // valorización no esté habilitada para ningún producto.
  COGS
}

// ORIGINAL: primer asiento de un evento de negocio (de venta/pago
// automático, o de un asiento manual ya contabilizado). REVERSAL: asiento
// de reversión (Bloque B), vinculado mediante AccountingEntry.
// reversesEntryId. Sigue sin existir un tercer valor: un asiento manual
// mientras es borrador NUNCA es una fila de AccountingEntry (ver
// ManualJournalDraft más abajo, Fase A4) — solo se convierte en una fila
// ORIGINAL real al contabilizarse.
enum AccountingEventType {
  ORIGINAL
  REVERSAL
}

// Ciclo de vida de un periodo contable mensual (Fase A2.1). Sin un tercer
// valor: nunca REJECTED/ARCHIVED/PENDING — la máquina es exactamente
// OPEN <-> CLOSED, simétrica y reversible solo mediante acción explícita de
// ADMIN (nunca automática en el sentido CLOSED -> OPEN).
enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

/**
 * Plan de cuentas (Fase 8, Bloque A — Documento Maestro §17:
 * "chart_of_accounts"; extendido en la Fase A1 a un plan jerárquico
 * compatible con PCGE). Las seis filas de sistema sembradas desde la Fase
 * 8 siguen siendo las únicas cuentas REALES hoy — A1 es la base técnica
 * (jerarquía, clasificación, postable/activa, mapeo reasignable), nunca la
 * importación de un PCGE completo ni la reasignación de ninguna cuenta de
 * sistema (eso exige el PCGE aprobado del contador, ver kickoff de A1).
 * Jerarquía (parentId/level, mismo patrón exacto que Category —
 * "AccountHierarchy", ver categories.service.ts): level se calcula
 * SIEMPRE en el servidor (parent.level + 1, o 1 si es raíz), nunca lo
 * envía el cliente. isPostable decide si la cuenta puede recibir líneas
 * NUEVAS de asiento (el motor sigue resolviendo por systemKey, nunca por
 * jerarquía); una cuenta con subcuentas no puede marcarse postable=true
 * (validado en el servicio, nunca con un trigger). status administra
 * activación/desactivación (mismo criterio que PaymentMethod.active):
 * nunca borrado físico, nunca afecta asientos ya posteados.
 */
model Account {
  id String @id @default(uuid()) @db.Uuid

  // Identificador interno estable. Las seis cuentas de sistema usan un
  // código corto no-PCGE ("CASH", "BANK", "AR", "VAT", "SALES",
  // "DISCOUNTS"); una cuenta PCGE usaría su código numérico oficial
  // (ninguna se inventa ni se siembra en A1). Inmutable después de creada
  // (mismo criterio que PaymentMethod.code): nunca editable vía PATCH.
  code String @unique @db.VarChar(20)

  // Nombre en español. Ancho 150 (Fase A1, antes 60): una denominación
  // PCGE oficial puede ser más larga que los nombres cortos de las seis
  // cuentas de sistema ("Caja", "Bancos", ...), que siguen cabiendo sin
  // cambios.
  name String @db.VarChar(150)

  type AccountType

  // Clave estable de mapeo (plan final §6 de la Fase 8). NULLABLE desde la
  // Fase A1 (antes obligatoria): una cuenta PCGE nueva no tiene por qué
  // resolver ningún evento automático. Sigue siendo única — Postgres
  // permite múltiples NULL en un índice único, así que cualquier cantidad
  // de cuentas PCGE sin mapeo coexiste sin conflicto; cuando SÍ tiene un
  // valor, sigue siendo 1:1 con una sola cuenta, exactamente como antes.
  // Reasignar qué cuenta sostiene un systemKey es una operación explícita
  // y auditada (ChartOfAccountsService.reassignSystemKey(), A1.3) que
  // NUNCA toca AccountingEntryLine.accountId de ningún asiento histórico.
  systemKey AccountingSystemKey? @unique @map("system_key")

  // Fase A5.2b: decisión EXPLÍCITA y opcional del contador — NULL (default,
  // en todas las cuentas de todas las fases anteriores y en toda cuenta
  // nueva) significa "esta cuenta ya es el destino final al recibir
  // mercadería: nunca generar una reclasificación artificial". Un valor NO
  // NULL marca esta cuenta como de TRÁNSITO y designa a cuál cuenta
  // reclasificar el monto proporcional recibido. Nunca se infiere del
  // nombre/código/systemKey de la cuenta (revisión A5.2b): es exclusivamente
  // este campo, configurado a mano, nunca sembrado ni activado por defecto.
  // Self-relation de un solo nivel — un objetivo con su propio objetivo
  // configurado es un estado inválido, rechazado por
  // AccountingEngine/ChartOfAccountsService, nunca por un CHECK recursivo.
  receiptReclassificationTargetAccountId String?  @map("receipt_reclassification_target_account_id") @db.Uuid
  receiptReclassificationTargetAccount   Account? @relation("AccountReceiptReclassificationTarget", fields: [receiptReclassificationTargetAccountId], references: [id], onDelete: Restrict)
  receiptReclassificationSourceAccounts  Account[] @relation("AccountReceiptReclassificationTarget")

  // Jerarquía (Fase A1 — PCGE §4), mismo patrón que Category
  // ("AccountHierarchy"). onDelete: Restrict: nunca se borra una cuenta
  // físicamente (ni este modelo expone un DELETE), así que esto es
  // defensa en profundidad, no un camino real de la aplicación.
  parentId String?   @map("parent_id") @db.Uuid
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Account[] @relation("AccountHierarchy")

  // Profundidad en el árbol (1 = raíz). SIEMPRE derivado por el servicio
  // a partir del padre, nunca aceptado del cliente — ver docblock del
  // modelo.
  level Int @default(1)

  // Si puede recibir líneas de asiento NUEVAS (el motor sigue resolviendo
  // por systemKey; esta bandera es la base para una futura validación de
  // mapeo PCGE, A1.3). Las seis cuentas de sistema nacen y permanecen
  // true (siguen en uso activo). Una cuenta con subcuentas no puede ser
  // postable (validado en el servicio).
  isPostable Boolean @default(true) @map("is_postable")

  // Activación/desactivación administrable (Fase A1). Las seis cuentas de
  // sistema nacen y permanecen ACTIVE (protegidas a nivel de servicio,
  // nunca a nivel de schema). Desactivar nunca borra ni reescribe
  // AccountingEntryLine alguno — mismo criterio que PaymentMethod.active.
  status AccountStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  // @default(now()) además de @updatedAt (a diferencia de Category, que
  // nació con esta columna desde su primera migración): las seis filas
  // YA EXISTENTES necesitan un valor de backfill explícito para esta
  // columna NOT NULL nueva; Prisma Client sigue reescribiéndola en cada
  // `.update()` real sin importar este default, que solo cubre el
  // backfill y el INSERT inicial.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  lines            AccountingEntryLine[]
  // Fase A4: líneas de borradores de asiento manual que referencian esta
  // cuenta — nunca el historial definitivo (eso sigue siendo
  // exclusivamente `lines` arriba).
  manualDraftLines ManualJournalDraftLine[]

  // Los 2 CHECK de code/name no en blanco (Fase 8), los 2 de la Fase A1
  // (level >= 1, no auto-padre) y el nuevo de la Fase A5.2b (una cuenta
  // nunca se designa su propio objetivo de reclasificación) se agregan a
  // mano en migration.sql, mismo criterio que Category/Unit/Product.
  @@index([parentId])
  @@index([status])
  @@index([receiptReclassificationTargetAccountId])
  @@map("chart_of_accounts")
}

/**
 * Asiento contable (Fase 8, Bloque A — Documento Maestro §17:
 * "accounting_entries"). Inmutable desde su creación: una corrección nunca
 * edita/elimina un asiento, siempre crea uno nuevo de tipo REVERSAL
 * (reversesEntryId). Sin AccountingEngine todavía (Bloque B): este modelo
 * es solo la forma de datos y sus restricciones.
 */
model AccountingEntry {
  id String @id @default(uuid()) @db.Uuid

  // Origen polimórfico deliberado (plan final §9/§12): sourceId es un UUID
  // SIN FK hacia Sale/Payment (mismo criterio que AuditLog.entityId e
  // InventoryMovement.referenceType/referenceId). Un asiento REVERSAL
  // conserva el MISMO sourceType/sourceId que su asiento ORIGINAL — el
  // vínculo entre ambos asientos es exclusivamente reversesEntryId, nunca
  // el par source.
  sourceType AccountingSourceType @map("source_type")
  sourceId   String               @map("source_id") @db.Uuid

  eventType AccountingEventType @map("event_type")

  // NULL en asientos ORIGINAL; obligatorio y único en asientos REVERSAL
  // (ver CHECK accounting_entries_reversal_consistency y el índice único
  // implícito de este campo, migration.sql): un asiento ORIGINAL se
  // reversa como máximo una vez. Self-relation sobre la misma tabla.
  reversesEntryId String?          @unique @map("reverses_entry_id") @db.Uuid
  reversesEntry   AccountingEntry? @relation("AccountingEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedByEntry AccountingEntry? @relation("AccountingEntryReversal")

  // Generado exclusivamente por backend (Bloque B), nunca por el cliente:
  // "Venta NV-000001", "Cobro de venta NV-000001", "Reversión de ...". Sin
  // PII (nombre de cliente), sin referencia de Payment, sin motivo de
  // anulación libre.
  description String @db.VarChar(200)

  // Instante factual del evento de negocio que origina el asiento (plan
  // final §22/§23): Sale.confirmedAt para un ORIGINAL de venta,
  // Payment.paidAt para un ORIGINAL de pago, el instante de anulación para
  // un REVERSAL. Sin @default: el Bloque B lo fija explícitamente: el
  // cliente nunca lo controla ni puede retrofecharlo.
  postedAt DateTime @map("posted_at")

  // Fase A2.2: fecha contable derivada de postedAt en la zona de negocio
  // (America/Lima, mismo criterio que common/date/business-date.ts), nunca
  // elegida por el cliente. Un asiento REVERSAL usa la fecha contable de SU
  // PROPIO postedAt (el instante de la anulación), nunca la del asiento
  // ORIGINAL que revierte. @db.Date: solo la fecha calendario importa, sin
  // componente de hora.
  accountingDate DateTime @map("accounting_date") @db.Date

  // Fase A2.1/A2.3: periodo contable mensual que contiene este asiento,
  // resuelto por AccountingEngine a partir de accountingDate (creado
  // automáticamente como OPEN si todavía no existe). Restrict: un periodo
  // con asientos nunca se puede borrar.
  periodId String           @map("period_id") @db.Uuid
  period   AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  // Fase A2.3: número secuencial, único y sin huecos POR PERIODO (nunca
  // global), asignado por AccountingEngine mediante el mismo patrón
  // transaccional que DocumentSequenceService.next() (UPDATE ... RETURNING
  // sobre AccountingPeriod.lastJournalNumber, dentro del mismo tx que crea
  // este asiento): si la transacción se revierte, el contador revierte con
  // ella. Un asiento REVERSAL recibe su propio número, nunca reutiliza el
  // del ORIGINAL. Sin edición manual posible (sin endpoint que lo exponga
  // como editable).
  journalNumber Int @map("journal_number")

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("AccountingEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  lines AccountingEntryLine[]

  // Fase A4: lado inverso de ManualJournalDraft.postedEntryId — SOLO
  // presente cuando sourceType=MANUAL (una venta/pago nunca tiene un
  // borrador asociado). Puramente informativo para trazabilidad; ningún
  // código de AccountingEngine lo consulta para decidir nada.
  postedByDraft ManualJournalDraft?

  // Fase A5.2a: lado inverso de PurchaseInvoice.postedEntryId — SOLO
  // presente cuando sourceType=PURCHASE. Mismo criterio exacto que
  // postedByDraft: puramente informativo, AccountingEngine nunca lo
  // consulta para decidir nada.
  postedByPurchaseInvoice PurchaseInvoice?

  // Fase A5.2b: lado inverso de PurchaseReceipt.reclassificationEntryId —
  // SOLO presente cuando sourceType=PURCHASE_RECEIPT. Mismo criterio
  // informativo exacto que postedByDraft/postedByPurchaseInvoice.
  postedByPurchaseReceiptReclassification PurchaseReceipt?

  // Fase A5.3: lado inverso de SupplierPayment.postedEntryId — SOLO
  // presente cuando sourceType=SUPPLIER_PAYMENT. Mismo criterio
  // informativo exacto que los anteriores.
  postedBySupplierPayment SupplierPayment?

  // Los 3 CHECK (description no en blanco, consistencia ORIGINAL/REVERSAL,
  // no auto-reversión) y el índice único parcial
  // accounting_entries_one_original_per_source se agregan a mano en
  // migration.sql: el DSL de Prisma no expresa CHECK ni WHERE de forma
  // declarativa (mismo criterio que Category/Sale/Payment/
  // InventoryMovement). journalNumber único POR periodo (@@unique abajo),
  // nunca global.
  @@unique([periodId, journalNumber])
  @@index([postedAt, id])
  @@index([sourceType, sourceId])
  @@index([eventType, postedAt])
  @@index([accountingDate])
  @@map("accounting_entries")
}

/**
 * Periodo contable mensual (Fase A2.1), identificado por (year, month).
 * Ciclo de vida OPEN/CLOSED administrado exclusivamente por ADMIN
 * (AccountingPeriodsService vía GET/POST /accounting/periods): MANAGEMENT
 * solo lee (mismo criterio ya cerrado para el resto del dominio contable,
 * P6-E4), SELLER/WAREHOUSE no tienen ningún acceso. AccountingEngine crea
 * automáticamente, dentro de su propia transacción de posteo, el periodo
 * del mes en curso como OPEN la primera vez que lo necesita — la actividad
 * comercial normal (confirmar una venta, cobrar un pago) nunca debe
 * bloquearse porque nadie inicializó manualmente el mes vigente. Un
 * periodo CLOSED nunca se reabre automáticamente: reopen() es siempre una
 * acción explícita y auditada de ADMIN.
 * lastJournalNumber es el contador transaccional de numeración de asientos
 * de ESTE periodo (mismo patrón que DocumentSequence.currentNumber):
 * siempre avanzado mediante un único UPDATE ... RETURNING dentro de la
 * transacción que postea el asiento, nunca mediante una secuencia de
 * PostgreSQL (CREATE SEQUENCE) — su nextval() no revierte con un ROLLBACK,
 * lo que dejaría huecos en la numeración comprometida; un UPDATE normal
 * sobre esta fila sí revierte junto con el resto de la transacción.
 */
model AccountingPeriod {
  id String @id @default(uuid()) @db.Uuid

  year  Int
  month Int

  status AccountingPeriodStatus @default(OPEN)

  lastJournalNumber Int @default(0) @map("last_journal_number")

  closedAt       DateTime? @map("closed_at")
  closedByUserId String?   @map("closed_by_user_id") @db.Uuid
  closedBy       User?     @relation("AccountingPeriodClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)

  reopenedAt       DateTime? @map("reopened_at")
  reopenedByUserId String?   @map("reopened_by_user_id") @db.Uuid
  reopenedBy       User?     @relation("AccountingPeriodReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  entries AccountingEntry[]

  // El CHECK de month (1-12) se agrega a mano en migration.sql, mismo
  // criterio que el resto del dominio (ver comentario de AccountingEntry
  // arriba).
  @@unique([year, month])
  @@index([status])
  @@map("accounting_periods")
}

// Ciclo de vida de un borrador de asiento manual (Fase A4.2). Solo dos
// estados: DRAFT (editable) -> POSTED (definitivo e inmutable). Nunca un
// tercer estado de aprobación — A4 no incluye ningún flujo de aprobación
// de supervisor (explícitamente fuera de alcance).
enum ManualJournalDraftStatus {
  DRAFT
  POSTED
}

/**
 * Borrador de asiento contable manual (Fase A4.2). Modelo DELIBERADAMENTE
 * separado de AccountingEntry — nunca una fila de AccountingEntry con un
 * eventType/estado "borrador": si así fuera, los reportes de A3 (que
 * leen AccountingEntry/AccountingEntryLine directamente, sin ningún
 * filtro de "solo definitivos") incluirían por error montos todavía no
 * contabilizados. Mientras `status=DRAFT`, sus líneas pueden estar
 * incompletas o desbalanceadas (A4.3: toda validación financiera se
 * exige recién al contabilizar, nunca mientras se edita). `postedEntryId`
 * es la trazabilidad explícita hacia el AccountingEntry definitivo una
 * vez contabilizado — nunca se reescribe después; la reversión posterior
 * (A4.5) crea un AccountingEntry REVERSAL aparte, enlazado por
 * AccountingEntry.reversesEntryId como cualquier otra reversión, sin
 * tocar este borrador en absoluto.
 */
model ManualJournalDraft {
  id String @id @default(uuid()) @db.Uuid

  accountingDate DateTime @map("accounting_date") @db.Date
  description    String   @db.VarChar(200)

  status ManualJournalDraftStatus @default(DRAFT)

  // NULL mientras DRAFT; se fija UNA sola vez, en la misma transacción
  // que AccountingEngine.postManualEntry() crea el AccountingEntry
  // definitivo (Fase A4.4) — nunca editable después.
  postedEntryId String?          @unique @map("posted_entry_id") @db.Uuid
  postedEntry   AccountingEntry? @relation(fields: [postedEntryId], references: [id], onDelete: Restrict)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("ManualJournalDraftCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  lines ManualJournalDraftLine[]

  // El CHECK de description no en blanco se agrega a mano en
  // migration.sql, mismo criterio que accounting_entries.description.
  @@index([status])
  @@map("manual_journal_drafts")
}

/**
 * Línea de un borrador de asiento manual (Fase A4.2). A diferencia de
 * AccountingEntryLine (inmutable, exactamente un lado positivo, CHECK de
 * base de datos estricto desde la Fase 8), una línea de BORRADOR tolera
 * un estado incompleto mientras se edita: debit=credit=0 es válido aquí
 * (línea todavía sin llenar), y nunca lleva su propio CHECK de cuadre
 * cruzado (eso es responsabilidad de AccountingEngine.postManualEntry(),
 * A4.3/A4.4, en el momento de contabilizar — nunca antes). Los únicos
 * invariantes que SÍ se protegen aquí a nivel de base de datos, incluso
 * en estado borrador, son los que nunca tienen una razón de negocio
 * legítima para violarse: ningún monto negativo, y nunca ambos lados
 * positivos a la vez (ver CHECK en migration.sql).
 */
model ManualJournalDraftLine {
  id String @id @default(uuid()) @db.Uuid

  draftId String             @map("draft_id") @db.Uuid
  draft   ManualJournalDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  accountId String  @map("account_id") @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  debitAmount  Decimal @default(0) @map("debit_amount") @db.Decimal(14, 2)
  creditAmount Decimal @default(0) @map("credit_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([draftId])
  @@index([accountId])
  @@map("manual_journal_draft_lines")
}

/**
 * Línea de un asiento contable (Fase 8, Bloque A — Documento Maestro §17:
 * "accounting_entry_lines"). Inmutable desde su creación, igual que
 * SaleItem/QuoteItem: componente de su AccountingEntry, nunca se edita
 * sola. Exactamente un lado (debit o credit) positivo por fila — CHECK
 * accounting_entry_lines_debit_credit_exclusive en migration.sql; el
 * cuadre cruzado SUM(debit)=SUM(credit) de todo el asiento es
 * responsabilidad del futuro AccountingEngine (Bloque B), no de la base de
 * datos (ver plan final §16).
 */
model AccountingEntryLine {
  id String @id @default(uuid()) @db.Uuid

  entryId String          @map("entry_id") @db.Uuid
  entry   AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId String  @map("account_id") @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  debitAmount  Decimal @default(0) @map("debit_amount") @db.Decimal(14, 2)
  creditAmount Decimal @default(0) @map("credit_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entryId])
  @@index([accountId, entryId])
  @@map("accounting_entry_lines")
}

// --- Configuración de la empresa (Fase 10, Bloque A) ------------------------

/**
 * Configuración global de la empresa: fila singleton única. `singleton` es a
 * la vez UNIQUE y forzada por CHECK a valer siempre TRUE (migration.sql):
 * ninguna de las dos restricciones por sí sola impide una segunda fila con
 * el valor opuesto, pero combinadas sí. La ausencia de esta fila tras el
 * seed se trata como violación de invariante interna (500), nunca como
 * "crear on-demand" — mismo criterio que un DocumentSequence faltante en
 * DocumentSequenceService.next().
 * taxEnabled/taxRate/quoteValidityDays/maxDiscountPercent se exponen desde
 * el Bloque A (GET), pero PATCH solo acepta los campos de identidad/moneda
 * en este bloque: quoteValidityDays/maxDiscountPercent se habilitan en el
 * Bloque B (integración con Cotizaciones/Ventas), taxEnabled/taxRate en el
 * Bloque C (integración con IGV). Ningún módulo de negocio lee todavía esta
 * tabla en el Bloque A: SettingsReader se exporta ahora para que los
 * Bloques B/C lo consuman sin reestructurar el módulo.
 */
model CompanySettings {
  id String @id @default(uuid()) @db.Uuid

  // UNIQUE + CHECK(singleton = TRUE) en conjunto (migration.sql) hacen
  // físicamente imposible una segunda fila, sin importar su valor.
  singleton Boolean @unique @default(true)

  businessName String  @map("business_name") @db.VarChar(150)
  tradeName    String? @map("trade_name") @db.VarChar(150)
  taxId        String? @map("tax_id") @db.VarChar(20)
  address      String? @db.VarChar(300)
  phone        String? @db.VarChar(30)
  email        String? @db.VarChar(150)

  currencyCode   String @default("PEN") @map("currency_code") @db.VarChar(3)
  currencySymbol String @default("S/") @map("currency_symbol") @db.VarChar(5)

  // Bloque C: activación y tasa de IGV. Editable por PATCH solo desde el
  // Bloque C; el Bloque A los expone en GET con su valor semilla.
  taxEnabled Boolean @default(false) @map("tax_enabled")
  taxRate    Decimal @default(18.00) @map("tax_rate") @db.Decimal(5, 2)

  // Bloque B: vigencia por defecto de una cotización y descuento máximo
  // permitido. Editable por PATCH solo desde el Bloque B.
  quoteValidityDays  Int     @default(15) @map("quote_validity_days")
  maxDiscountPercent Decimal @default(100.00) @map("max_discount_percent") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Las 7 CHECK (singleton = TRUE, business_name no en blanco vía BTRIM,
  // tax_rate 0-100, quote_validity_days > 0, max_discount_percent 0-100,
  // currency_code formato ISO de 3 letras mayúsculas, currency_symbol no en
  // blanco vía BTRIM) se agregan a mano en migration.sql, mismo criterio
  // que el resto del dominio.
  @@map("company_settings")
}

// --- Facturación electrónica (Fase 11, Bloque B: fundación fiscal) ---------
//
// Sale sigue siendo la transacción comercial; ElectronicDocument es un
// agregado FISCAL aparte, generado a partir de una Sale ya confirmada
// (Fase 11A, decisión cerrada #2). Este bloque NO implementa emision: solo
// el modelo de datos, sin FiscalSeriesService/ElectronicDocumentsService/
// proveedor/controllers/DTOs/Swagger/auditoria/impresion (eso es el
// siguiente bloque).
//
// Numeracion fiscal deliberadamente SEPARADA de DocumentSequence/
// DocumentType (que siguen sirviendo exclusivamente a QUOTE/SALE
// comerciales, sin modificar): FiscalSeries admite multiples series activas
// por tipo de documento fiscal (p. ej. F001 y F002 para FACTURA), algo que
// el documentType unico de DocumentSequence no puede representar.

// Tipos de documento fiscal (Fase 11A #3): enum PROPIO, nunca una extension
// de DocumentType (que es exclusivamente comercial). Solo los dos tipos
// primarios del MVP; NOTA_CREDITO/NOTA_DEBITO son fuera de alcance de este
// bloque (ver el indice unico parcial de ElectronicDocument mas abajo,
// disenado para admitirlos despues sin redisenar Sale).
enum FiscalDocumentType {
  FACTURA
  BOLETA
}

// Ciclo de vida INTERNO del documento fiscal, deliberadamente distinto del
// estado crudo que cualquier proveedor real devuelva (Fase 11A #21):
// providerStatus/providerMessage en ElectronicDocument cargan el vocabulario
// propio del proveedor; este enum nunca se contamina con esos valores.
// CREATED: numero fiscal ya asignado, aun no comunicado. SUBMITTED: en
// curso o comunicado, en espera de resolucion. SUBMISSION_FAILED: fallo
// TECNICO (red/timeout), reintentable con el MISMO numero, nunca una
// asignacion nueva. ACCEPTED/REJECTED: resolucion final del proveedor.
// Sin PENDING (redundante con CREATED), sin VOIDED/CANCELLED/CREDIT_NOTE
// (extension futura de notas de credito, Fase 11A #34) en este bloque.
enum ElectronicDocumentStatus {
  CREATED
  SUBMITTED
  SUBMISSION_FAILED
  ACCEPTED
  REJECTED
}

/**
 * Numeracion fiscal por (documentType, series): tabla dedicada, nunca una
 * generalizacion de DocumentSequence (Fase 11A #9, decision cerrada:
 * DocumentSequence.documentType es unico, asi que no puede representar
 * varias series activas para un mismo tipo de documento). current_number es
 * el ULTIMO numero emitido (0 = ninguno todavia), mismo criterio que
 * DocumentSequence.currentNumber. El futuro FiscalSeriesService
 * incrementara con un unico UPDATE ... RETURNING dentro de la transaccion
 * del llamador, igual que DocumentSequenceService.next(). Sin logica de
 * asignacion en este bloque: solo el modelo.
 */
model FiscalSeries {
  id String @id @default(uuid()) @db.Uuid

  documentType FiscalDocumentType @map("document_type")

  // Exactamente 4 caracteres alfanumericos en mayuscula, primer caracter
  // fijo por tipo de documento (F.../B...); ver los 2 CHECK agregados a
  // mano en migration.sql (Fase 11A #23: reglas de serie aprobadas para
  // Peru, sin implicar mapeo UBL/proveedor todavia).
  series String @db.VarChar(4)

  currentNumber Int     @default(0) @map("current_number")
  active        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  electronicDocuments ElectronicDocument[]

  // Una serie es unica POR tipo de documento: permite multiples series
  // activas por tipo sin ningun cambio de esquema futuro. El CHECK de
  // formato de serie (migration.sql) ya distingue F.../B... por
  // documentType, asi que en la practica una serie nunca podria reutilizarse
  // entre FACTURA y BOLETA de todos modos: el indice compuesto es la
  // garantia real a nivel de base de datos.
  @@unique([documentType, series])
  @@map("fiscal_series")
}

/**
 * Agregado fiscal (Fase 11, Bloque B, solo modelo, sin logica de emision).
 * Snapshot completo e inmutable desde el momento de creacion (Fase 11A
 * #15/#19): ningun campo de este modelo se recalcula ni se relee desde
 * Customer/Product/CompanySettings despues de creado. El futuro
 * ElectronicDocumentsService sera responsable de poblar estos campos
 * copiando desde Sale (identidad de cliente y montos ya congelados ahi) y
 * desde CompanySettings vigente SOLO en el instante de emision (issuer*).
 * providerCode es VARCHAR, nunca un enum de Prisma (Fase 11A #22, decision
 * cerrada de este bloque): agregar un proveedor futuro (PSE, SUNAT directo)
 * nunca debe requerir una migracion de base de datos.
 */
model ElectronicDocument {
  id String @id @default(uuid()) @db.Uuid

  saleId String @map("sale_id") @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  fiscalSeriesId String       @map("fiscal_series_id") @db.Uuid
  fiscalSeries   FiscalSeries @relation(fields: [fiscalSeriesId], references: [id], onDelete: Restrict)

  // documentType/series/number se copian del FiscalSeries usado en el
  // momento de la asignacion (denormalizado a proposito, mismo criterio que
  // Sale.number frente a DocumentSequence): la identidad fiscal de un
  // documento ya emitido nunca debe depender de un JOIN vivo hacia
  // FiscalSeries para mostrarse ni para su unicidad.
  documentType FiscalDocumentType @map("document_type")
  series       String             @db.VarChar(4)
  // 1..99,999,999 (Fase 11A #23). Sin fullNumber almacenado (Fase 11A
  // #13, decision cerrada de este bloque): el futuro mapper/renderer arma
  // "F001-00000001" (relleno a 8 digitos) a partir de series+number.
  number       Int

  status ElectronicDocumentStatus @default(CREATED)

  // Nunca un enum (ver comentario del modelo). "MOCK" es el unico valor que
  // existira cuando el siguiente bloque implemente el proveedor; ningun
  // proveedor se implementa en este bloque.
  providerCode String @map("provider_code") @db.VarChar(20)

  currencyCode String @map("currency_code") @db.VarChar(3)

  // Snapshot del EMISOR (Fase 11A #16/#19): copiado de CompanySettings en el
  // instante de emision, nunca releido despues. issuerAddress nullable
  // porque CompanySettings.address ya es nullable hoy (Fase 11A #21: no se
  // agregan columnas nuevas a CompanySettings en este bloque).
  issuerTaxId        String  @map("issuer_tax_id") @db.VarChar(20)
  issuerBusinessName String  @map("issuer_business_name") @db.VarChar(150)
  issuerAddress      String? @map("issuer_address") @db.VarChar(300)

  // Snapshot del CLIENTE (Fase 11A #16/#19): se copiara del snapshot YA
  // congelado en Sale (customerDocumentType/customerDocumentNumber/
  // customerName/customerAddress), nunca de una lectura viva de Customer.
  customerDocumentType   CustomerDocumentType? @map("customer_document_type")
  customerDocumentNumber String?               @map("customer_document_number") @db.VarChar(32)
  customerName           String                @map("customer_name") @db.VarChar(150)
  customerAddress        String?               @map("customer_address") @db.VarChar(300)

  // Snapshot MONETARIO (Fase 11A #16/#19): se copiara de Sale.subtotal/
  // discountAmount/taxAmount/total, nunca recalculado. A diferencia de
  // Sale (que no persiste una base imponible separada), aqui SI se
  // almacena taxableBase de forma explicita (Bloque 11B #16): un documento
  // fiscal debe mostrar la base imponible como linea propia.
  subtotal       Decimal @db.Decimal(14, 2)
  discountAmount Decimal @map("discount_amount") @db.Decimal(14, 2)
  taxableBase    Decimal @map("taxable_base") @db.Decimal(14, 2)
  taxAmount      Decimal @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)

  // R2-B1: copia VERBATIM de Sale.pricesIncludeTax al emitir, para que el
  // documento fiscal sea autocontenido (sabe cómo leer sus propias líneas
  // sin consultar la venta). Sin @default a propósito (ver Quote).
  pricesIncludeTax Boolean @map("prices_include_tax")

  // Metadata de proveedor: opaca para el dominio (nunca se ramifica logica
  // de negocio sobre providerStatus/providerMessage; ver Fase 11A #21/#28).
  // Todos nullable: no existen hasta el primer intento de envio, que este
  // bloque no implementa.
  providerExternalId String? @map("provider_external_id") @db.VarChar(100)
  providerStatus     String? @map("provider_status") @db.VarChar(50)
  providerMessage    String? @map("provider_message") @db.VarChar(500)

  // Contador de intentos de envio (Fase 11A #25/#29): incrementado por el
  // futuro ElectronicDocumentsService en cada intento real al proveedor,
  // nunca en este bloque.
  submissionCount Int @default(0) @map("submission_count")

  // issuedAt: instante de creacion/asignacion del numero fiscal (analogo a
  // Sale.confirmedAt), sin @default: el futuro servicio lo fija
  // explicitamente. Los demas son nullable hasta que ocurra cada evento.
  issuedAt        DateTime  @map("issued_at")
  lastSubmittedAt DateTime? @map("last_submitted_at")
  acceptedAt      DateTime? @map("accepted_at")
  rejectedAt      DateTime? @map("rejected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items ElectronicDocumentItem[]

  // Identidad fiscal unica a nivel de base de datos: dos documentos nunca
  // pueden compartir (documentType, series, number) (Fase 11A #18).
  @@unique([documentType, series, number])
  // Ademas del indice unico parcial de "documento primario" (agregado a
  // mano en migration.sql, ver comentario ahi), se indexan por separado los
  // campos de consulta previstos por las futuras rutas de lista/detalle
  // (Fase 11A #40/#41): saleId (el unico parcial no cubre necesariamente
  // toda consulta futura, p. ej. una nota de credito), status, createdAt,
  // customerDocumentNumber.
  @@index([saleId])
  @@index([status])
  @@index([createdAt])
  @@index([customerDocumentNumber])
  @@map("electronic_documents")
}

/**
 * Snapshot inmutable de linea (Fase 11A #11/#14, decision cerrada: NUNCA
 * una FK a SaleItem/Product). Copiado desde SaleItem en el instante de
 * creacion del documento fiscal; un cambio posterior de Product/SaleItem
 * jamas debe poder alterar un item fiscal ya emitido. Sin codigo de
 * catalogo SUNAT ni campos UBL (Fase 11A #14/#47, decision cerrada de ese
 * bloque: requieren una decision regulatoria/de proveedor explicita, fuera
 * de alcance aqui; el proveedor MOCK no tiene validez fiscal real, ver
 * CLAUDE.md §7). NR-03 agrega discountType/discountValue/discountAmount
 * (copiados EXACTAMENTE del SaleItem de origen, igual que el resto del
 * snapshot): la decision cerrada previa de "sin descuento por linea" se
 * refería a que esta tabla no calcula ni valida nada por si misma, no a
 * que no pueda conservar el snapshot ya calculado en SaleItem.
 */
model ElectronicDocumentItem {
  id String @id @default(uuid()) @db.Uuid

  electronicDocumentId String             @map("electronic_document_id") @db.Uuid
  electronicDocument   ElectronicDocument @relation(fields: [electronicDocumentId], references: [id], onDelete: Cascade)

  lineNumber Int @map("line_number")

  productSku  String @map("product_sku") @db.VarChar(40)
  description String @db.VarChar(150)

  unitCode         String @map("unit_code") @db.VarChar(15)
  unitName         String @map("unit_name") @db.VarChar(60)
  unitAbbreviation String @map("unit_abbreviation") @db.VarChar(10)

  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)

  // NR-03: copiado EXACTAMENTE del SaleItem de origen al emitir el
  // comprobante — nunca recalculado. En un comprobante sobre una venta
  // directa (sin descuento de línea) queda null/null/0, igual que antes.
  discountType   LineDiscountType? @map("discount_type")
  discountValue  Decimal?          @map("discount_value") @db.Decimal(14, 2)
  discountAmount Decimal           @default(0) @map("discount_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  // Sin updatedAt: inmutable desde su creacion, mismo criterio que
  // SaleItem/QuoteItem. Como maximo una linea por numero por documento;
  // electronicDocumentId como prefijo izquierdo de este unico compuesto ya
  // cubre "cargar items de un documento" (mismo criterio que SaleItem: no
  // se agrega un indice adicional, seria redundante). Los 4 CHECK
  // (lineNumber >= 1, quantity > 0, unitPrice >= 0, lineTotal >= 0), el
  // CHECK de aritmetica (ahora con discount_amount) y los CHECK de
  // consistencia de descuento se agregan a mano en migration.sql.
  @@unique([electronicDocumentId, lineNumber])
  @@map("electronic_document_items")
}

// --- Arqueos de caja (Ticket B post-MVP, Bloque B1) -------------------------
//
// SOLO PERSISTENCIA: sin controller, sin service propio, sin endpoints, sin
// auditoría propia, sin reglas de negocio aplicadas todavía. Este bloque
// existe para que un bloque posterior (apertura/cierre/aprobación) tenga un
// esquema ya validado y probado sobre el que construir, sin necesidad de una
// migración adicional para el modelo base.
//
// Exactamente 3 estados aprobados — sin REJECTED/CANCELLED/APPROVED: un
// rechazo vuelve la fila a OPEN (el snapshot del intento de cierre se
// limpia) y el historial de esa decisión vive en AuditLog, nunca como un
// estado terminal propio de CashSession (evita el problema de "cuál fue el
// último rechazo" ante intentos repetidos).
enum CashSessionStatus {
  OPEN
  PENDING_APPROVAL
  CLOSED
}

/**
 * Un arqueo de caja por cobrador (Ticket B, Bloque B1). Cada usuario puede
 * tener como máximo UNA fila sin resolver (OPEN o PENDING_APPROVAL) a la
 * vez — invariante de concurrencia protegida por un índice único parcial
 * (`cash_sessions_one_unresolved_per_user`, agregado a mano en
 * migration.sql, ver comentario ahí; el DSL de Prisma no expresa WHERE
 * parcial). La responsabilidad de caja pertenece a la IDENTIDAD del usuario,
 * nunca a su rol activo de sesión (sin roleSnapshot/activeRole aquí): un
 * mismo usuario ADMIN o SELLER es el mismo dueño de caja
 * independientemente del rol con el que haya iniciado sesión en un momento
 * dado.
 * Máquina de 3 estados (sin REJECTED/CANCELLED/APPROVED, ver
 * CashSessionStatus): OPEN -> PENDING_APPROVAL (cierre con descuadre) ->
 * OPEN (rechazo, snapshot de cierre limpiado) o CLOSED (aprobación); OPEN ->
 * CLOSED directo (cierre sin descuadre, sin revisor). Los 3 campos de
 * aprobación (approvedByUserId/approvedAt/approvalComment) representan
 * ÚNICAMENTE una aprobación real de un cierre con descuadre — un cierre
 * limpio nunca los puebla (ver `cash_sessions_status_consistency` en
 * migration.sql). Sin rejectedByUserId/rejectedAt/rejectionReason a
 * propósito: el rechazo no es un estado terminal propio, así que no hay
 * "el último rechazo" que fijar aquí sin ambigüedad ante reintentos — esa
 * evidencia histórica es responsabilidad exclusiva de AuditLog, en un
 * bloque posterior que sí emita esa acción.
 */
model CashSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation("CashSessionOwner", fields: [userId], references: [id], onDelete: Restrict)

  status CashSessionStatus @default(OPEN)

  // Apertura: siempre manual, siempre obligatoria, nunca negativa (CHECK en
  // migration.sql). Puede ser 0 (caja abierta sin fondo inicial).
  openingAmount Decimal  @map("opening_amount") @db.Decimal(14, 2)
  openedAt      DateTime @default(now()) @map("opened_at")

  // Snapshot del intento de cierre vigente: NULL mientras OPEN (incluido
  // tras un rechazo, que limpia estos 5 campos), poblado en
  // PENDING_APPROVAL y en CLOSED. differenceAmount = countedCashAmount -
  // expectedCashAmount, verificado por
  // `cash_sessions_difference_arithmetic` en migration.sql — nunca
  // calculado con punto flotante (Decimal(14,2) = NUMERIC(14,2) exacto).
  // expectedCashAmount se calculará en un bloque posterior a partir de
  // openingAmount + suma de Payments ACTIVE que afectan caja de esta
  // sesión — esa aritmética es cross-table (Payment), nunca un CHECK de
  // esta sola tabla.
  closeRequestedAt   DateTime? @map("close_requested_at")
  expectedCashAmount Decimal?  @map("expected_cash_amount") @db.Decimal(14, 2)
  countedCashAmount  Decimal?  @map("counted_cash_amount") @db.Decimal(14, 2)
  differenceAmount   Decimal?  @map("difference_amount") @db.Decimal(14, 2)
  closingObservation String?   @map("closing_observation") @db.VarChar(500)

  closedAt DateTime? @map("closed_at")

  // Solo se puebla para un cierre con descuadre finalmente APROBADO (nunca
  // para un cierre sin descuadre, nunca mientras PENDING_APPROVAL). ADMIN y
  // MANAGEMENT son los revisores aprobados; la prohibición de
  // autoaprobación (session.userId === reviewer.id) es responsabilidad de
  // un servicio de un bloque posterior, no requiere ninguna columna aquí.
  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  approvedBy       User?     @relation("CashSessionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt       DateTime? @map("approved_at")
  approvalComment  String?   @map("approval_comment") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments               Payment[]
  paymentMethodSummaries CashSessionPaymentMethodSummary[]

  // El índice único parcial de "como máximo una fila sin resolver por
  // usuario" (agregado a mano en migration.sql) ya cubre, como efecto
  // colateral, la única consulta de lectura ya aprobada para un bloque
  // posterior ("¿tiene este usuario una CashSession sin resolver?" — WHERE
  // user_id = ? AND status IN ('OPEN','PENDING_APPROVAL')): Postgres puede
  // usar un índice único parcial para ese lookup exacto, así que no se
  // agrega un @@index([userId, status]) redundante. Sin índices sobre
  // status/openedAt/closedAt en solitario: ningún patrón de consulta real
  // los necesita todavía en B1 (persistencia únicamente) — se agregarían de
  // forma aditiva en el bloque que primero los evidencie (p. ej. un futuro
  // listado de arqueos para revisión), nunca por anticipación.
  @@map("cash_sessions")
}

/**
 * Desglose por método de pago del cierre de una CashSession (Ticket B,
 * Bloque B1: solo tabla, sin filas hasta un bloque de negocio posterior). Se
 * crea junto con el snapshot de cierre (closeRequestedAt en adelante) —
 * nunca antes, nunca vacío para todos los métodos activos (un bloque
 * posterior solo crea una fila por método efectivamente representado por
 * Payments ACTIVE de esa sesión). paymentMethodId es la FK real e
 * inmutable (PaymentMethod nunca se borra físicamente, ver
 * PaymentMethodsService) — nunca nullable, a diferencia de una FK
 * "defensiva" pensada para un flujo de borrado que este dominio no permite.
 * paymentMethodCode/paymentMethodName son el mismo tipo de snapshot
 * histórico que Payment.paymentMethodCode/paymentMethodName (Ticket C,
 * Bloque C3): un método renombrado después no debe alterar un cierre ya
 * registrado.
 */
model CashSessionPaymentMethodSummary {
  id String @id @default(uuid()) @db.Uuid

  cashSessionId String      @map("cash_session_id") @db.Uuid
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  paymentMethodId String        @map("payment_method_id") @db.Uuid
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  paymentMethodCode String @map("payment_method_code") @db.VarChar(30)
  paymentMethodName String @map("payment_method_name") @db.VarChar(60)

  totalAmount Decimal @map("total_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  // Identidad relacional real: PaymentMethod.code es único e inmutable, así
  // que (cashSessionId, paymentMethodId) es la clave natural — nunca
  // (cashSessionId, paymentMethodCode), que duplicaría esa identidad sobre
  // un campo snapshot en vez de la FK estable. cashSessionId como prefijo
  // izquierdo de este único compuesto ya cubre "cargar el desglose de una
  // sesión" (mismo criterio que ElectronicDocumentItem con
  // electronicDocumentId): no se agrega un índice adicional solo sobre
  // cashSessionId.
  @@unique([cashSessionId, paymentMethodId])
  @@map("cash_session_payment_method_summaries")
}
