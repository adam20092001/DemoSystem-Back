# =============================================================
# Plantilla de variables de entorno.
# Copiar a .env y ajustar los valores locales.
# El archivo .env NUNCA se versiona.
# =============================================================

# --- Aplicación ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (consumidas por Docker Compose) ---
POSTGRES_DB=pos_db
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_password
POSTGRES_PORT=5432

# --- Conexión de Prisma / NestJS ---
# Debe coincidir con las credenciales POSTGRES_* de arriba.
DATABASE_URL=postgresql://pos_user:pos_password@localhost:5432/pos_db?schema=public

# --- API ---
# Orígenes permitidos por CORS. Acepta varios separados por coma.
# Origen permitido para el frontend Angular local de DemoSystem
CORS_ORIGIN=http://localhost:4201
SWAGGER_ENABLED=true

# --- Autenticación (JWT en cookie HttpOnly) ---
# Obligatorio, mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# No usar el valor de ejemplo — no es un secreto válido para ningún entorno.
JWT_SECRET=changeme-generate-a-real-32-plus-character-secret
# Formato <número><m|h|d>, por ejemplo 30m, 8h o 1d.
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=demosystem_session
# lax | strict | none. "none" exige NODE_ENV=production (Secure=true).
AUTH_COOKIE_SAMESITE=lax
MAX_LOGIN_ATTEMPTS=5
LOGIN_THROTTLE_TTL_MS=60000
LOGIN_THROTTLE_LIMIT=10

# --- Imágenes de productos (almacenamiento local en disco) ---
# Carpeta relativa donde se guardan los archivos físicos de imágenes.
PRODUCT_UPLOAD_DIR=uploads/products
# Tamaño máximo por imagen, en bytes. Mínimo 1024.
PRODUCT_IMAGE_MAX_SIZE_BYTES=5242880

# --- Facturación electrónica (Fase 11, Bloque C) ---
# Único valor soportado por ahora: mock (MockElectronicInvoicingProvider).
ELECTRONIC_INVOICING_PROVIDER=mock

# --- SIRE DEMO (solo demostración; SIN comunicación real con SUNAT) ---
# Todo apagado por defecto. Con SIRE_DEMO_ENABLED=false el módulo entero no
# existe: sus rutas responden 404 y no aparecen en Swagger.
# Valores válidos: true | false (cualquier otro valor aborta el arranque).
SIRE_DEMO_ENABLED=false
# Habilita el origen DEMO_FIXTURES (documentos sintéticos en memoria). Requiere
# SIRE_DEMO_ENABLED=true; sin él el arranque falla.
SIRE_DEMO_FIXTURES_ENABLED=false
# Autorización EXPLÍCITA para usar el módulo con NODE_ENV=production. Con
# NODE_ENV=production y SIRE_DEMO_ENABLED=true, sin esta variable en true el
# arranque falla. No la actives en una instalación productiva real.
SIRE_DEMO_ALLOW_IN_PRODUCTION=false

# --- Seed inicial (solo consumidas por prisma/seed.ts, no por NestJS) ---
# No incluir valores reales aquí. Ver .env para los valores de desarrollo.
# Obligatorias para "npm run db:seed": crean el usuario ADMIN inicial
# (mustChangePassword=true). Reejecutar el seed nunca resetea su contraseña
# ni sus datos si el usuario ya existe.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Datos de demostración OPCIONALES (solo consumidas por prisma/demo-seed.ts) ---
# Usadas EXCLUSIVAMENTE por "npm run db:seed:demo" — NestJS nunca lee esta
# variable en tiempo de ejecución, y el seed de infraestructura
# ("npm run db:seed") tampoco la usa. El script se niega a ejecutar si
# NODE_ENV=production, sin excepción.
# Debe cumplir la MISMA política de contraseñas que cualquier usuario del
# sistema (mínimo 12 caracteres, al menos una letra y un número). Nunca
# reutilices una contraseña real ni la de INITIAL_ADMIN_PASSWORD.
DEMO_USER_PASSWORD=
