# =============================================================
# Plantilla de variables de entorno.
# Copiar a .env y ajustar los valores locales.
# El archivo .env NUNCA se versiona.
# =============================================================

# --- Aplicación ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (consumidas por Docker Compose) ---
POSTGRES_DB=pos_db
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_password
POSTGRES_PORT=5432

# --- Conexión de Prisma / NestJS ---
# Debe coincidir con las credenciales POSTGRES_* de arriba.
DATABASE_URL=postgresql://pos_user:pos_password@localhost:5432/pos_db?schema=public

# --- API ---
# Orígenes permitidos por CORS. Acepta varios separados por coma.
# Origen permitido para el frontend Angular local de DemoSystem
CORS_ORIGIN=http://localhost:4201
SWAGGER_ENABLED=true
