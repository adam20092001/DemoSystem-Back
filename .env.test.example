# =============================================================
# Plantilla de entorno EXCLUSIVA para pruebas e2e.
# Copiar a .env.test y ajustar si hace falta. Nunca se versiona.
# Apunta únicamente a pos_db_test — jamás a la base de desarrollo pos_db.
# =============================================================

# --- Aplicación ---
NODE_ENV=test
PORT=3100

# --- PostgreSQL de pruebas (segundo servicio Docker, puerto 5433) ---
TEST_POSTGRES_DB=pos_db_test
TEST_POSTGRES_USER=pos_test_user
TEST_POSTGRES_PASSWORD=pos_test_password
TEST_POSTGRES_PORT=5433

# --- Conexión de Prisma / NestJS para e2e ---
DATABASE_URL=postgresql://pos_test_user:pos_test_password@localhost:5433/pos_db_test?schema=public

# NOTA DE SEGURIDAD (INC-E2E-database-guard): DATABASE_URL debe apuntar EXACTAMENTE
# a pos_db_test, en localhost/127.0.0.1/::1, con el puerto TEST_POSTGRES_PORT y el
# usuario TEST_POSTGRES_USER de arriba. Una DATABASE_URL exportada en el shell que
# contradiga este archivo aborta las pruebas (ENV_CONFLICT).
#
# --- Base DESCARTABLE (opcional, ver README "Seguridad de la base de datos de pruebas") ---
# NO definir estas variables aquí. Solo en .env.test.local (no versionado), junto a
# un DATABASE_URL que apunte EXACTAMENTE al mismo host:puerto/base:
#   DATABASE_URL=postgresql://<usuario>:<clave>@localhost:<puerto>/pos_db_test_<sufijo>?schema=public
#   E2E_DISPOSABLE_TARGET=localhost:<puerto>/pos_db_test_<sufijo>
#   E2E_DISPOSABLE_TOKEN=<generar: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))">
# Luego: npm run db:test:mark-disposable (solo sobre una base vacía).

# --- API ---
CORS_ORIGIN=http://localhost:4201
SWAGGER_ENABLED=true

# --- Autenticación (JWT en cookie HttpOnly) ---
# Obligatorio, mínimo 32 caracteres. Distinto del secreto de desarrollo.
JWT_SECRET=changeme-generate-a-real-32-plus-character-secret-for-tests
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=demosystem_session
AUTH_COOKIE_SAMESITE=lax
MAX_LOGIN_ATTEMPTS=5
LOGIN_THROTTLE_TTL_MS=60000
# Alto a propósito: el límite bajo se prueba con su propia suite aislada,
# para no interferir con el resto de las pruebas de auth.
LOGIN_THROTTLE_LIMIT=1000

# --- Imágenes de productos ---
# Valor solo referencial: test/jest-e2e.setup.ts sobrescribe PRODUCT_UPLOAD_DIR
# con una carpeta temporal exclusiva de pruebas antes de cargar este archivo,
# para nunca escribir imágenes de e2e dentro de la carpeta real de desarrollo.
PRODUCT_UPLOAD_DIR=uploads/products-test-placeholder
PRODUCT_IMAGE_MAX_SIZE_BYTES=5242880

# --- Seed de prueba (solo consumidas por prisma/seed.ts, no por NestJS) ---
# Credenciales exclusivas de e2e — nunca las de desarrollo.
INITIAL_ADMIN_USERNAME=e2e_admin
INITIAL_ADMIN_EMAIL=e2e_admin@demosystem.test
INITIAL_ADMIN_PASSWORD=changeme-test-only-password-2026
